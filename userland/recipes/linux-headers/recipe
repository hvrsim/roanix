name=linux-headers
version=7.1.3
revision=1
source_method=tarball
tarball_url="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${version}.tar.xz"
tarball_blake2b="b6466e2798627522f0339c670a223b21266f4d4ede39163867c0f122295e54c5d24093abb51d5c6c6c917de0cb199836e81f45f7c391a5cc138cac2a519438e8"
imagedeps="build-essential rsync"
clean_workdirs=no

configure() {
    cp -a "${source_dir}"/. .
}

build() {
    case "${JINX_ARCH}" in
        x86_64) linux_arch=x86 ;;
        riscv64) linux_arch=riscv ;;
        *) echo "linux-headers: unsupported architecture ${JINX_ARCH}" >&2; return 1 ;;
    esac

    rm -rf stage
    make \
        -C "${PWD}" \
        ARCH="${linux_arch}" \
        headers_install \
        INSTALL_HDR_PATH="${PWD}/stage"
}

package() {
    mkdir -p "${dest_dir}${prefix}"
    cp -a stage/include "${dest_dir}${prefix}/"
}
