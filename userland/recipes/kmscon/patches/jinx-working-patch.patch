diff --git kmscon-workdir/src/uterm/vt_logind.c kmscon-workdir/src/uterm/vt_logind.c
new file mode 100644
index 0000000..ad23452
--- /dev/null
+++ kmscon-workdir/src/uterm/vt_logind.c
@@ -0,0 +1,312 @@
+/* SPDX-License-Identifier: MIT */
+/* Native logind session and device control, without a kernel VT requirement. */
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <systemd/sd-bus.h>
+#include <time.h>
+#include <unistd.h>
+#include "vt_internal.h"
+#include "shl/log.h"
+#include "shl/misc.h"
+
+#define LOG_SUBSYSTEM "logind"
+#define LOGIN "org.freedesktop.login1"
+#define MANAGER_PATH "/org/freedesktop/login1"
+#define MANAGER LOGIN ".Manager"
+#define SESSION LOGIN ".Session"
+
+struct device {
+    struct device *next;
+    int id;
+    unsigned int major, minor;
+};
+struct pause {
+    struct pause *next;
+    unsigned int major, minor;
+};
+struct logind_vt {
+    struct uterm_vt base;
+    sd_bus *bus;
+    sd_bus_slot *properties, *paused, *resumed, *removed;
+    struct ev_fd *watch;
+    struct ev_timer *timer;
+    struct device *devices;
+    struct pause *pauses;
+    char *session, *path, *seat;
+    int fifo, next_id;
+    bool refresh, enabled;
+};
+static struct logind_vt *native(struct uterm_vt *vt)
+{
+    return shl_offsetof(vt, struct logind_vt, base);
+}
+static int send_method(struct logind_vt *vt, const char *path, const char *interface,
+                       const char *method, const char *types, ...)
+{
+    sd_bus_message *message = NULL;
+    va_list args;
+    int r = sd_bus_message_new_method_call(vt->bus, &message, LOGIN, path, interface, method);
+    if (r >= 0) r = sd_bus_message_set_expect_reply(message, 0);
+    va_start(args, types);
+    if (r >= 0) r = sd_bus_message_appendv(message, types, args);
+    va_end(args);
+    if (r >= 0) r = sd_bus_send(vt->bus, message, NULL);
+    sd_bus_message_unref(message);
+    return r;
+}
+static void release_device(struct logind_vt *vt, unsigned int major, unsigned int minor)
+{
+    send_method(vt, vt->path, SESSION, "ReleaseDevice", "uu", major, minor);
+}
+static int open_device(struct uterm_vt *base, const char *node, int *id)
+{
+    struct logind_vt *vt = native(base);
+    sd_bus_error error = SD_BUS_ERROR_NULL;
+    sd_bus_message *reply = NULL;
+    struct stat st;
+    struct device *device;
+    int borrowed, paused, fd = -1, r;
+    if (stat(node, &st) < 0) return -errno;
+    if (!S_ISCHR(st.st_mode)) return -ENODEV;
+    device = calloc(1, sizeof(*device));
+    if (!device) return -ENOMEM;
+    if (vt->next_id == INT_MAX) { free(device); return -EOVERFLOW; }
+    device->major = major(st.st_rdev);
+    device->minor = minor(st.st_rdev);
+    r = sd_bus_call_method(vt->bus, LOGIN, vt->path, SESSION, "TakeDevice", &error, &reply,
+                           "uu", device->major, device->minor);
+    if (r >= 0) r = sd_bus_message_read(reply, "hb", &borrowed, &paused);
+    if (r >= 0) {
+        if (paused) r = -EACCES;
+        else if ((fd = fcntl(borrowed, F_DUPFD_CLOEXEC, 0)) < 0) r = -errno;
+        if (r < 0) release_device(vt, device->major, device->minor);
+    }
+    if (r < 0) {
+        log_warning("TakeDevice(%s): %s", node, error.message ? error.message : strerror(-r));
+        free(device);
+    } else {
+        *id = device->id = ++vt->next_id;
+        device->next = vt->devices;
+        vt->devices = device;
+    }
+    sd_bus_message_unref(reply);
+    sd_bus_error_free(&error);
+    return r < 0 ? r : fd;
+}
+static void close_device(struct uterm_vt *base, int fd, int id)
+{
+    struct logind_vt *vt = native(base);
+    struct device **link = &vt->devices, *device;
+
+    close(fd);
+    while ((device = *link)) {
+        if (device->id == id) {
+            struct pause **pending = &vt->pauses;
+            while (*pending) {
+                struct pause *pause = *pending;
+                if (pause->major == device->major && pause->minor == device->minor) {
+                    send_method(vt, vt->path, SESSION, "PauseDeviceComplete", "uu",
+                                pause->major, pause->minor);
+                    *pending = pause->next;
+                    free(pause);
+                    break;
+                }
+                pending = &pause->next;
+            }
+            *link = device->next;
+            release_device(vt, device->major, device->minor);
+            free(device);
+            break;
+        }
+        link = &device->next;
+    }
+}
+static int input_open(const char *node, int *id, void *data)
+{
+    return open_device(data, node, id);
+}
+static void input_close(int fd, int id, void *data)
+{
+    close_device(data, fd, id);
+}
+static int changed(sd_bus_message *message, void *data, sd_bus_error *error)
+{
+    struct logind_vt *vt = data;
+    vt->refresh = true;
+    return 0;
+}
+static int paused(sd_bus_message *message, void *data, sd_bus_error *error)
+{
+    struct logind_vt *vt = data;
+    unsigned int major, minor;
+    const char *type;
+    int r = sd_bus_message_read(message, "uus", &major, &minor, &type);
+    if (r < 0) return r;
+    /* udev removes a vanished device without deactivating the seat. */
+    if (!strcmp(type, "gone")) return 0;
+    vt->enabled = false;
+    if (!strcmp(type, "pause")) {
+        struct pause *pause = calloc(1, sizeof(*pause));
+        if (!pause) return -ENOMEM;
+        pause->major = major; pause->minor = minor;
+        pause->next = vt->pauses; vt->pauses = pause;
+    }
+    return 0;
+}
+static int removed(sd_bus_message *message, void *data, sd_bus_error *error)
+{
+    struct logind_vt *vt = data;
+    const char *id, *path;
+    int r = sd_bus_message_read(message, "so", &id, &path);
+    if (r < 0) return r;
+    if (!strcmp(id, vt->session)) {
+        vt->base.hup = true;
+        vt->enabled = false;
+    }
+    return 0;
+}
+static int apply_state(struct logind_vt *vt)
+{
+    int r;
+    if (vt->refresh && !vt->pauses) {
+        int active;
+        vt->refresh = false;
+        r = sd_bus_get_property_trivial(vt->bus, LOGIN, vt->path, SESSION, "Active", NULL, 'b', &active);
+        if (r < 0) return r;
+        vt->enabled = active;
+    }
+    if (vt->enabled) vt_cb_activate(&vt->base);
+    else vt_cb_deactivate(&vt->base, true);
+    while (vt->pauses) {
+        struct pause *pause = vt->pauses;
+        send_method(vt, vt->path, SESSION, "PauseDeviceComplete", "uu", pause->major, pause->minor);
+        vt->pauses = pause->next;
+        free(pause);
+    }
+    return 0;
+}
+static int arm(struct logind_vt *vt)
+{
+    struct itimerspec spec = {0};
+    struct timespec now;
+    uint64_t timeout, current, delay;
+    int events = sd_bus_get_events(vt->bus);
+    if (events < 0) return events;
+    int r = ev_fd_update(vt->watch, ((events & POLLIN) ? EV_READABLE : 0) |
+                                   ((events & POLLOUT) ? EV_WRITEABLE : 0));
+    if (r < 0) return r;
+    r = sd_bus_get_timeout(vt->bus, &timeout);
+    if (r < 0) return r;
+    if (timeout != UINT64_MAX) {
+        if (clock_gettime(CLOCK_MONOTONIC, &now) < 0) return -errno;
+        current = (uint64_t)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+        delay = timeout > current ? timeout - current : 1;
+        spec.it_value.tv_sec = delay / 1000000;
+        spec.it_value.tv_nsec = (delay % 1000000) * 1000;
+    }
+    return ev_timer_update(vt->timer, &spec);
+}
+static void dispatch(struct logind_vt *vt)
+{
+    int r;
+    while ((r = sd_bus_process(vt->bus, NULL)) > 0) {}
+    if (r >= 0) r = apply_state(vt);
+    if (r >= 0 && !vt->base.hup) r = arm(vt);
+    if (r < 0 || vt->base.hup) {
+        log_warning("logind connection lost: %s", r < 0 ? strerror(-r) : "session removed");
+        vt_cb_deactivate(&vt->base, true);
+        vt_cb_hup(&vt->base);
+    }
+}
+static void fd_event(struct ev_fd *fd, int mask, void *data) { dispatch(data); }
+static void timer_event(struct ev_timer *timer, uint64_t count, void *data) { dispatch(data); }
+static int activate(struct uterm_vt *base)
+{
+    struct logind_vt *vt = native(base);
+    int r = sd_bus_call_method(vt->bus, LOGIN, vt->path, SESSION, "Activate", NULL, NULL, "");
+    if (r < 0) return r;
+    vt->refresh = true;
+    r = apply_state(vt);
+    return r < 0 ? r : arm(vt);
+}
+static int deactivate(struct uterm_vt *base) { return vt_cb_deactivate(base, true); }
+static const char *seat_name(struct uterm_vt *base) { return native(base)->seat; }
+static void destroy(struct uterm_vt *base)
+{
+    struct logind_vt *vt = native(base);
+    vt_cb_deactivate(base, true);
+    input_sleep(base->input);
+    if (vt->watch) ev_eloop_rm_fd(vt->watch);
+    if (vt->timer) ev_eloop_rm_timer(vt->timer);
+    while (vt->devices) {
+        struct device *device = vt->devices;
+        release_device(vt, device->major, device->minor);
+        vt->devices = device->next;
+        free(device);
+    }
+    while (vt->pauses) { struct pause *pause = vt->pauses; vt->pauses = pause->next; free(pause); }
+    if (vt->path) send_method(vt, vt->path, SESSION, "ReleaseControl", "");
+    if (vt->session) send_method(vt, MANAGER_PATH, MANAGER, "ReleaseSession", "s", vt->session);
+    if (vt->fifo >= 0) close(vt->fifo);
+    sd_bus_slot_unref(vt->properties); sd_bus_slot_unref(vt->paused);
+    sd_bus_slot_unref(vt->resumed); sd_bus_slot_unref(vt->removed);
+    sd_bus_flush_close_unref(vt->bus);
+    free(vt->session); free(vt->path); free(vt->seat);
+}
+static const struct uterm_vt_ops ops = {
+    .activate = activate, .deactivate = deactivate, .destroy = destroy,
+    .get_name = seat_name, .open_device = open_device, .close_device = close_device,
+};
+struct uterm_vt *uterm_vt_logind_new(struct ev_eloop *eloop, struct input *input)
+{
+    struct logind_vt *vt = calloc(1, sizeof(*vt));
+    sd_bus_error error = SD_BUS_ERROR_NULL;
+    sd_bus_message *reply = NULL;
+    const char *session, *path, *runtime, *seat;
+    unsigned int uid, vtnr;
+    int fifo, existing, r;
+    if (!vt) return NULL;
+    vt->fifo = -1;
+    vt->base.eloop = eloop; vt->base.input = input; vt->base.ops = &ops;
+    r = sd_bus_open_system(&vt->bus);
+    if (r < 0) goto fail;
+    r = sd_bus_call_method(vt->bus, LOGIN, MANAGER_PATH, MANAGER, "CreateSession", &error, &reply,
+                          "uusssssussbssa(sv)", (unsigned int)getuid(), (unsigned int)getpid(),
+                          "kmscon", "tty", "user-light", "", "seat0", 0U, "", "", 0, "", "", 0);
+    if (r < 0) goto fail;
+    r = sd_bus_message_read(reply, "soshusub", &session, &path, &runtime, &fifo, &uid, &seat, &vtnr, &existing);
+    if (r < 0) goto fail;
+    vt->session = strdup(session); vt->path = strdup(path); vt->seat = strdup(seat);
+    if (!vt->session || !vt->path || !vt->seat) { r = -ENOMEM; goto fail; }
+    vt->fifo = fcntl(fifo, F_DUPFD_CLOEXEC, 0);
+    if (vt->fifo < 0) { r = -errno; goto fail; }
+    if (setenv("XDG_SESSION_ID", session, 1) || setenv("XDG_SEAT", seat, 1) ||
+        setenv("XDG_SESSION_TYPE", "tty", 1) || setenv("XDG_RUNTIME_DIR", runtime, 1)) { r = -errno; goto fail; }
+    sd_bus_message_unref(reply); reply = NULL;
+    r = sd_bus_call_method(vt->bus, LOGIN, vt->path, SESSION, "TakeControl", &error, NULL, "b", 0);
+    if (r < 0) goto fail;
+    r = sd_bus_match_signal(vt->bus, &vt->properties, LOGIN, vt->path,
+                           "org.freedesktop.DBus.Properties", "PropertiesChanged", changed, vt);
+    if (r >= 0) r = sd_bus_match_signal(vt->bus, &vt->paused, LOGIN, vt->path, SESSION, "PauseDevice", paused, vt);
+    if (r >= 0) r = sd_bus_match_signal(vt->bus, &vt->resumed, LOGIN, vt->path, SESSION, "ResumeDevice", changed, vt);
+    if (r >= 0) r = sd_bus_match_signal(vt->bus, &vt->removed, LOGIN, MANAGER_PATH, MANAGER, "SessionRemoved", removed, vt);
+    if (r < 0) goto fail;
+    r = ev_eloop_new_fd(eloop, &vt->watch, sd_bus_get_fd(vt->bus), EV_READABLE, fd_event, vt);
+    if (r >= 0) r = ev_eloop_new_timer(eloop, &vt->timer, NULL, timer_event, vt);
+    if (r >= 0) r = arm(vt);
+    if (r < 0) goto fail;
+    input_set_device_ops(input, input_open, input_close, &vt->base);
+    log_notice("logind session %s on %s", vt->session, vt->seat);
+    return &vt->base;
+fail:
+    log_error("cannot establish logind session: %s", error.message ? error.message : strerror(-r));
+    sd_bus_error_free(&error); sd_bus_message_unref(reply);
+    destroy(&vt->base); free(vt);
+    return NULL;
+}
