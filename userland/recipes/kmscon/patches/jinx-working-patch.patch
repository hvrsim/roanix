diff --git kmscon-workdir/src/uterm/monitor_roanix.c kmscon-workdir/src/uterm/monitor_roanix.c
new file mode 100644
index 0000000..c75d4ff
--- /dev/null
+++ kmscon-workdir/src/uterm/monitor_roanix.c
@@ -0,0 +1,179 @@
+/* SPDX-License-Identifier: MIT */
+/* Discover native device nodes, including devices added after seat startup. */
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include "monitor.h"
+#include "shl/dlist.h"
+
+struct uterm_monitor_dev {
+	struct dlist list;
+	struct uterm_monitor *mon;
+	enum uterm_monitor_dev_type type;
+	char *node;
+	dev_t filesystem;
+	ino_t inode;
+	bool seen;
+	void *data;
+};
+
+struct uterm_monitor {
+	unsigned long ref;
+	struct ev_eloop *eloop;
+	struct ev_timer *timer;
+	struct uterm_monitor_cb cb;
+	struct dlist devices;
+	void *data;
+	bool scanning;
+};
+
+static void remove_device(struct uterm_monitor_dev *dev)
+{
+	dlist_unlink(&dev->list);
+	dev->mon->cb.free_dev(dev->mon->data, dev->type, dev->data);
+	free(dev->node);
+	free(dev);
+}
+
+static bool device_name(const char *name, const char *prefix)
+{
+	size_t length = strlen(prefix);
+	if (strncmp(name, prefix, length) || !name[length])
+		return false;
+	for (const char *p = name + length; *p; p++)
+		if (!isdigit((unsigned char)*p))
+			return false;
+	return true;
+}
+
+static void scan_directory(struct uterm_monitor *mon, const char *directory,
+			   const char *prefix, enum uterm_monitor_dev_type type)
+{
+	DIR *dir = opendir(directory);
+	struct dirent *entry;
+	if (!dir)
+		return;
+	while ((entry = readdir(dir))) {
+		struct uterm_monitor_dev *dev, *found = NULL;
+		struct stat status;
+		char *path;
+		if (!device_name(entry->d_name, prefix))
+			continue;
+		if (asprintf(&path, "%s/%s", directory, entry->d_name) < 0)
+			continue;
+		if (stat(path, &status) || !S_ISCHR(status.st_mode)) {
+			free(path);
+			continue;
+		}
+		dlist_for_each_entry(dev, &mon->devices, list) {
+			if (!strcmp(dev->node, path)) {
+				found = dev;
+				break;
+			}
+		}
+		if (found && (found->filesystem != status.st_dev || found->inode != status.st_ino)) {
+			remove_device(found);
+			found = NULL;
+		}
+		if (found) {
+			found->seen = true;
+			free(path);
+			continue;
+		}
+		dev = calloc(1, sizeof(*dev));
+		if (!dev) {
+			free(path);
+			continue;
+		}
+		dev->mon = mon;
+		dev->node = path;
+		dev->filesystem = status.st_dev;
+		dev->inode = status.st_ino;
+		dev->type = type;
+		dev->seen = true;
+		dlist_link_tail(&mon->devices, &dev->list);
+		mon->cb.new_dev(path, type, type == UTERM_MONITOR_DRM && !strcmp(entry->d_name, "card0")
+				? UTERM_MONITOR_PRIMARY : 0,
+				mon->data, dev);
+	}
+	closedir(dir);
+}
+
+static void scan(struct uterm_monitor *mon)
+{
+	struct uterm_monitor_dev *dev;
+	struct dlist *next;
+	dlist_for_each_entry(dev, &mon->devices, list)
+		dev->seen = false;
+	scan_directory(mon, "/dev/dri", "card", UTERM_MONITOR_DRM);
+	scan_directory(mon, "/dev/input", "event", UTERM_MONITOR_INPUT);
+	dlist_for_each_entry_safe(dev, next, &mon->devices, list)
+		if (!dev->seen)
+			remove_device(dev);
+}
+
+static void rescan(struct ev_timer *timer, uint64_t count, void *data)
+{
+	struct uterm_monitor *mon = data;
+	if (mon->scanning)
+		scan(mon);
+}
+
+int uterm_monitor_new(struct uterm_monitor **out, struct ev_eloop *eloop,
+		      struct uterm_monitor_cb *cb, void *data)
+{
+	struct uterm_monitor *mon = calloc(1, sizeof(*mon));
+	struct itimerspec interval = {.it_value.tv_sec = 1, .it_interval.tv_sec = 1};
+	int ret;
+	if (!mon)
+		return -ENOMEM;
+	mon->ref = 1;
+	mon->eloop = eloop;
+	mon->cb = *cb;
+	mon->data = data;
+	dlist_init(&mon->devices);
+	ret = ev_eloop_new_timer(eloop, &mon->timer, &interval, rescan, mon);
+	if (ret) {
+		free(mon);
+		return ret;
+	}
+	ev_eloop_ref(eloop);
+	*out = mon;
+	return 0;
+}
+
+void uterm_monitor_ref(struct uterm_monitor *mon)
+{
+	if (mon)
+		++mon->ref;
+}
+
+void uterm_monitor_unref(struct uterm_monitor *mon)
+{
+	struct uterm_monitor_dev *dev;
+	struct dlist *next;
+	if (!mon || --mon->ref)
+		return;
+	ev_eloop_rm_timer(mon->timer);
+	dlist_for_each_entry_safe(dev, next, &mon->devices, list)
+		remove_device(dev);
+	ev_eloop_unref(mon->eloop);
+	free(mon);
+}
+
+void uterm_monitor_scan(struct uterm_monitor *mon, const char *seat_name)
+{
+	if (!mon || strcmp(seat_name, "seat0"))
+		return;
+	mon->scanning = true;
+	scan(mon);
+}
+
+void uterm_monitor_set_dev_data(struct uterm_monitor_dev *dev, void *data)
+{
+	dev->data = data;
+}
