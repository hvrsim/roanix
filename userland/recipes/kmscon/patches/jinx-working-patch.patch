diff --git kmscon-workdir/src/uterm/vt_roanix.c kmscon-workdir/src/uterm/vt_roanix.c
new file mode 100644
index 0000000..255cf0c
--- /dev/null
+++ kmscon-workdir/src/uterm/vt_roanix.c
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: MIT */
+/* Roanix has a userspace seat; terminal sessions are managed by kmscon. */
+#include <stdlib.h>
+#include "vt_internal.h"
+
+static int activate(struct uterm_vt *vt)
+{
+	vt_cb_activate(vt);
+	return 0;
+}
+
+static int deactivate(struct uterm_vt *vt)
+{
+	return vt_cb_deactivate(vt, false);
+}
+
+static void destroy(struct uterm_vt *vt)
+{
+	vt_cb_deactivate(vt, true);
+	input_sleep(vt->input);
+}
+
+static const struct uterm_vt_ops ops = {
+	.activate = activate,
+	.deactivate = deactivate,
+	.destroy = destroy,
+};
+
+struct uterm_vt *uterm_vt_roanix_new(struct ev_eloop *eloop, struct input *input)
+{
+	struct uterm_vt *vt = calloc(1, sizeof(*vt));
+	if (!vt)
+		return NULL;
+	vt->eloop = eloop;
+	vt->input = input;
+	vt->ops = &ops;
+	input_wake_up(input);
+	return vt;
+}
