@@ -0,0 +1,34 @@
+#pragma once
+
+#include <mlibc/sysdep-signatures.hpp>
+
+namespace mlibc {
+
+struct RoanixSysdepTags :
+    LibcLog,
+    LibcPanic,
+    Exit,
+    TcbSet,
+    FutexWait,
+    FutexWake,
+    AnonAllocate,
+    AnonFree,
+    Open,
+    Read,
+    Write,
+    Seek,
+    Close,
+    Isatty,
+    ClockGet,
+    VmMap,
+    VmUnmap
+{};
+
+template<typename Tag>
+using Sysdeps = SysdepOf<RoanixSysdepTags, Tag>;
+
+struct SysdepTraits {
+    static constexpr bool usesRtNetlink = false;
+};
+
+} // namespace mlibc
diff --git a/sysdeps/roanix/include/roanix/syscall.h b/sysdeps/roanix/include/roanix/syscall.h
new file mode 100644
index 0000000..48048ef
--- /dev/null
+++ b/sysdeps/roanix/include/roanix/syscall.h
@@ -0,0 +1,147 @@
+#ifndef ROANIX_SYSCALL_H
+#define ROANIX_SYSCALL_H
+
+#include <stdint.h>
+
+enum roanix_syscall_number {
+    ROANIX_SYS_PROCESS_EXIT = 0,
+    ROANIX_SYS_THREAD_SET_POINTER,
+    ROANIX_SYS_FUTEX_WAIT,
+    ROANIX_SYS_FUTEX_WAKE,
+    ROANIX_SYS_FILE_OPEN,
+    ROANIX_SYS_FILE_CLOSE,
+    ROANIX_SYS_FILE_READ,
+    ROANIX_SYS_FILE_WRITE,
+    ROANIX_SYS_FILE_SEEK,
+    ROANIX_SYS_CLOCK_GET,
+    ROANIX_SYS_MEMORY_MAP,
+    ROANIX_SYS_MEMORY_UNMAP
+};
+
+typedef long roanix_syscall_word_t;
+
+#if defined(__x86_64__)
+
+static inline roanix_syscall_word_t roanix_syscall0(long number) {
+    register long result __asm__("rax") = number;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        :
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall1(long number, long a0) {
+    register long result __asm__("rax") = number;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall2(long number, long a0, long a1) {
+    register long result __asm__("rax") = number;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall3(
+        long number, long a0, long a1, long a2) {
+    register long result __asm__("rax") = number;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1), "d"(a2)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall4(
+        long number, long a0, long a1, long a2, long a3) {
+    register long result __asm__("rax") = number;
+    register long arg3 __asm__("r10") = a3;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1), "d"(a2), "r"(arg3)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall5(
+        long number, long a0, long a1, long a2, long a3, long a4) {
+    register long result __asm__("rax") = number;
+    register long arg3 __asm__("r10") = a3;
+    register long arg4 __asm__("r8") = a4;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1), "d"(a2), "r"(arg3), "r"(arg4)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall6(
+        long number, long a0, long a1, long a2, long a3, long a4, long a5) {
+    register long result __asm__("rax") = number;
+    register long arg3 __asm__("r10") = a3;
+    register long arg4 __asm__("r8") = a4;
+    register long arg5 __asm__("r9") = a5;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1), "d"(a2), "r"(arg3), "r"(arg4), "r"(arg5)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+#elif defined(__riscv) && __riscv_xlen == 64
+
+static inline roanix_syscall_word_t roanix_syscall6(
+        long number, long a0, long a1, long a2, long a3, long a4, long a5) {
+    register long x10 __asm__("a0") = a0;
+    register long x11 __asm__("a1") = a1;
+    register long x12 __asm__("a2") = a2;
+    register long x13 __asm__("a3") = a3;
+    register long x14 __asm__("a4") = a4;
+    register long x15 __asm__("a5") = a5;
+    register long x17 __asm__("a7") = number;
+    __asm__ volatile("ecall"
+        : "+r"(x10)
+        : "r"(x11), "r"(x12), "r"(x13), "r"(x14), "r"(x15), "r"(x17)
+        : "memory");
+    return x10;
+}
+
+static inline roanix_syscall_word_t roanix_syscall5(
+        long number, long a0, long a1, long a2, long a3, long a4) {
+    return roanix_syscall6(number, a0, a1, a2, a3, a4, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall4(
+        long number, long a0, long a1, long a2, long a3) {
+    return roanix_syscall6(number, a0, a1, a2, a3, 0, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall3(
+        long number, long a0, long a1, long a2) {
+    return roanix_syscall6(number, a0, a1, a2, 0, 0, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall2(long number, long a0, long a1) {
+    return roanix_syscall6(number, a0, a1, 0, 0, 0, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall1(long number, long a0) {
+    return roanix_syscall6(number, a0, 0, 0, 0, 0, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall0(long number) {
+    return roanix_syscall6(number, 0, 0, 0, 0, 0, 0);
+}
+
+#else
+#error "Roanix supports only x86_64 and riscv64"
+#endif
+
+#endif
