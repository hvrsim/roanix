diff --git a/sysdeps/roanix/generic/entry.cpp b/sysdeps/roanix/generic/entry.cpp
new file mode 100644
index 0000000..9e8955e
--- /dev/null
+++ b/sysdeps/roanix/generic/entry.cpp
@@ -0,0 +1,19 @@
+#include <stdint.h>
+#include <stdlib.h>
+#include <mlibc/elf/startup.h>
+
+extern "C" void __dlapi_enter(uintptr_t *);
+
+extern char **environ;
+
+extern "C" void __mlibc_entry(
+        uintptr_t *entry_stack,
+        int (*main_fn)(int argc, char *argv[], char *env[])) {
+    __dlapi_enter(entry_stack);
+    int result = main_fn(
+        mlibc::entry_stack.argc,
+        mlibc::entry_stack.argv,
+        environ
+    );
+    exit(result);
+}
diff --git a/sysdeps/roanix/generic/sysdeps.cpp b/sysdeps/roanix/generic/sysdeps.cpp
new file mode 100644
index 0000000..9f79836
--- /dev/null
+++ b/sysdeps/roanix/generic/sysdeps.cpp
@@ -0,0 +1,198 @@
+#include <errno.h>
+#include <limits.h>
+#include <string.h>
+#include <sys/mman.h>
+
+#include <mlibc/all-sysdeps.hpp>
+#include <mlibc/tcb.hpp>
+#include <roanix/syscall.h>
+
+namespace {
+
+constexpr bool syscall_failed(long result) {
+    return result < 0 && result >= -4095;
+}
+
+int syscall_error(long result) {
+    return syscall_failed(result) ? static_cast<int>(-result) : 0;
+}
+
+long as_word(const void *pointer) {
+    return static_cast<long>(reinterpret_cast<uintptr_t>(pointer));
+}
+
+} // namespace
+
+namespace mlibc {
+
+void Sysdeps<LibcLog>::operator()(const char *message) {
+    ssize_t ignored;
+    sysdep<Write>(2, message, strlen(message), &ignored);
+}
+
+[[noreturn]] void Sysdeps<LibcPanic>::operator()() {
+    sysdep<LibcLog>("mlibc: unrecoverable error\n");
+    sysdep<Exit>(127);
+}
+
+[[noreturn]] void Sysdeps<Exit>::operator()(int status) {
+    roanix_syscall1(ROANIX_SYS_PROCESS_EXIT, status);
+    __builtin_unreachable();
+}
+
+int Sysdeps<TcbSet>::operator()(void *pointer) {
+    uintptr_t thread_pointer = reinterpret_cast<uintptr_t>(pointer);
+#if defined(__riscv) && __riscv_xlen == 64
+    thread_pointer += sizeof(Tcb);
+#endif
+    long result = roanix_syscall1(
+        ROANIX_SYS_THREAD_SET_POINTER,
+        static_cast<long>(thread_pointer)
+    );
+    return syscall_error(result);
+}
+
+int Sysdeps<FutexWait>::operator()(
+        int *pointer, int expected, const struct timespec *timeout) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FUTEX_WAIT,
+        as_word(pointer),
+        expected,
+        as_word(timeout)
+    );
+    return syscall_error(result);
+}
+
+int Sysdeps<FutexWake>::operator()(int *pointer, bool all) {
+    long result = roanix_syscall2(
+        ROANIX_SYS_FUTEX_WAKE,
+        as_word(pointer),
+        all ? INT_MAX : 1
+    );
+    return syscall_error(result);
+}
+
+int Sysdeps<AnonAllocate>::operator()(size_t size, void **pointer) {
+    return sysdep<VmMap>(
+        nullptr,
+        size,
+        PROT_READ | PROT_WRITE,
+        MAP_PRIVATE | MAP_ANONYMOUS,
+        -1,
+        0,
+        pointer
+    );
+}
+
+int Sysdeps<AnonFree>::operator()(void *pointer, size_t size) {
+    return sysdep<VmUnmap>(pointer, size);
+}
+
+int Sysdeps<Open>::operator()(
+        const char *path, int flags, mode_t mode, int *fd) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_OPEN,
+        as_word(path),
+        flags,
+        mode
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *fd = static_cast<int>(result);
+    return error;
+}
+
+int Sysdeps<Close>::operator()(int fd) {
+    return syscall_error(roanix_syscall1(ROANIX_SYS_FILE_CLOSE, fd));
+}
+
+int Sysdeps<Isatty>::operator()(int) {
+    return ENOTTY;
+}
+
+int Sysdeps<Read>::operator()(
+        int fd, void *buffer, size_t size, ssize_t *bytes_read) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_READ,
+        fd,
+        as_word(buffer),
+        size
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *bytes_read = result;
+    return error;
+}
+
+int Sysdeps<Write>::operator()(
+        int fd, const void *buffer, size_t size, ssize_t *bytes_written) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_WRITE,
+        fd,
+        as_word(buffer),
+        size
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *bytes_written = result;
+    return error;
+}
+
+int Sysdeps<Seek>::operator()(
+        int fd, off_t offset, int whence, off_t *new_offset) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_SEEK,
+        fd,
+        offset,
+        whence
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *new_offset = result;
+    return error;
+}
+
+int Sysdeps<ClockGet>::operator()(
+        int clock, time_t *seconds, long *nanoseconds) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_CLOCK_GET,
+        clock,
+        as_word(seconds),
+        as_word(nanoseconds)
+    );
+    return syscall_error(result);
+}
+
+int Sysdeps<VmMap>::operator()(
+        void *hint,
+        size_t size,
+        int protection,
+        int flags,
+        int fd,
+        off_t offset,
+        void **window) {
+    long result = roanix_syscall6(
+        ROANIX_SYS_MEMORY_MAP,
+        as_word(hint),
+        size,
+        protection,
+        flags,
+        fd,
+        offset
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *window = reinterpret_cast<void *>(result);
+    return error;
+}
+
+int Sysdeps<VmUnmap>::operator()(void *pointer, size_t size) {
+    long result = roanix_syscall2(
+        ROANIX_SYS_MEMORY_UNMAP,
+        as_word(pointer),
+        size
+    );
+    return syscall_error(result);
+}
+
+} // namespace mlibc
