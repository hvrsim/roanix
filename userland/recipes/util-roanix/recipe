#! /bin/sh

version=0.1
revision=29
source_dir="util-roanix"
hostdeps="gcc-host binutils"
deps="sys-libs"

configure() {
    cp -a "${source_dir}"/. .
}

build() {
    make \
        CC="${OS_TRIPLET}-gcc" \
        CFLAGS="${TARGET_CFLAGS}" \
        LDFLAGS="${TARGET_LDFLAGS}" \
        -j"${parallelism}"
}

package() {
    install -Dm755 init "${dest_dir}/usr/bin/init"
    install -Dm755 dmesg "${dest_dir}/usr/bin/dmesg"
    install -Dm644 roanix-root "${dest_dir}/etc/roanix-root"
    install -Dm644 roanix-root "${dest_dir}/dev/.roanix-keep"
    install -Dm644 roanix-root "${dest_dir}/tmp/.roanix-keep"
    # API filesystems must have mount points before the read-only root is used.
    for directory in proc sys sys/fs/cgroup run; do
        install -Dm644 roanix-root "${dest_dir}/${directory}/.roanix-keep"
    done

    install -d -m755 "${dest_dir}/sbin"
    ln -s ../usr/bin/init "${dest_dir}/sbin/init"

    # Canonical executable and runtime paths for the native image.
    install -d -m755 "${dest_dir}/var"
    ln -s usr/bin "${dest_dir}/bin"
    ln -s bin "${dest_dir}/usr/sbin"
    ln -s ../run "${dest_dir}/var/run"
}
