+#if !defined(CPU_EQUAL)
+static bool stress_cpu_equal(const cpu_set_t *left, const cpu_set_t *right)
+{
+	return memcmp(left, right, sizeof(*left)) == 0;
+}
+
+#define CPU_EQUAL(left, right) stress_cpu_equal((left), (right))
+#endif
+
+#if !defined(CPU_OR)
+static void stress_cpu_or(
+	cpu_set_t *result,
+	const cpu_set_t *left,
+	const cpu_set_t *right)
+{
+	unsigned char *output = (unsigned char *)result;
+	const unsigned char *lhs = (const unsigned char *)left;
+	const unsigned char *rhs = (const unsigned char *)right;
+	size_t i;
+
+	for (i = 0; i < sizeof(*result); i++)
+		output[i] = lhs[i] | rhs[i];
+}
+
+#define CPU_OR(result, left, right) stress_cpu_or((result), (left), (right))
+#endif
