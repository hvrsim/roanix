#! /bin/sh

version=1764d1493063388df9ab42544cb5da371b44fd58
revision=2
git_url="https://gitlab.com/sortix/os-test.git"
commit="1764d1493063388df9ab42544cb5da371b44fd58"
imagedeps="build-essential"
hostdeps="bootstrap-gcc binutils"
deps="base"

configure() {
    cp -a "${source_dir}"/. .
    rm -rf .git
}

build() {
    make \
        OS=Roanix \
        CC="${OS_TRIPLET}-gcc" \
        CC_FOR_BUILD=gcc \
        CFLAGS="${TARGET_CFLAGS}" \
        CPPFLAGS="${TARGET_CPPFLAGS}" \
        LDFLAGS="${TARGET_LDFLAGS}" \
        CFLAGS_FOR_BUILD="-O2 -pipe" \
        CPPFLAGS_FOR_BUILD="" \
        LDFLAGS_FOR_BUILD="" \
        -j"${parallelism}"
}

package() {
    installed="${dest_dir}/.os-test-installed"
    candidates="${dest_dir}/.os-test-candidates"
    case "${JINX_ARCH}" in
        x86_64) expected_machine="Advanced Micro Devices X86-64" ;;
        riscv64) expected_machine="RISC-V" ;;
        *) echo "os-test: unsupported architecture ${JINX_ARCH}" >&2; return 1 ;;
    esac

    rm -f "${installed}"
    : >"${candidates}"
    for suite in $(cat misc/suites.list); do
        if ! find "${suite}" -type f -perm /111 -print >>"${candidates}"; then
            rm -f "${candidates}" "${installed}"
            return 1
        fi
    done
    while IFS= read -r binary; do
        if [ ! -f "${binary}.c" ]; then
            continue
        fi
        machine=$("${OS_TRIPLET}-readelf" -h "${binary}" 2>/dev/null |
            sed -n 's/^[[:space:]]*Machine:[[:space:]]*//p')
        if [ "${machine}" != "${expected_machine}" ]; then
            continue
        fi
        if ! install -Dm755 "${binary}" "${dest_dir}/usr/share/os-test/${binary#./}"; then
            rm -f "${candidates}" "${installed}"
            return 1
        fi
        : >"${installed}"
    done <"${candidates}"
    rm -f "${candidates}"

    if [ ! -f "${installed}" ]; then
        echo "os-test: no target binaries were built" >&2
        return 1
    fi
    rm -f "${installed}"
}
