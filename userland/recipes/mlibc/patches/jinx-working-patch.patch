+    ROANIX_SYS_FILE_SYNC,
+    ROANIX_SYS_PROCESS_NOFILE,
+    ROANIX_SYS_PROCESS_PARENT_SIGNAL,
+    ROANIX_SYS_PROCESS_GETMAIN_TID,
+    ROANIX_SYS_FILE_WRITEV,
+    ROANIX_SYS_FILE_MKNODAT
+};
+
+enum {
+    ROANIX_POWER_HALT = 0,
+    ROANIX_POWER_REBOOT = 1,
+    ROANIX_POWER_OFF = 2
+};
+
+/// Longest thread name the kernel stores, excluding the NUL terminator.
+#define ROANIX_THREAD_NAME_MAX 15
+
+/// `process_getpriority` returns `ROANIX_PRIO_BIAS - nice` so that a valid
+/// result is never negative, which the syscall ABI reserves for errors.
+#define ROANIX_PRIO_BIAS 20
+
+#define ROANIX_UTSNAME_FIELD_SIZE 65
+
+struct roanix_utsname {
+    char sysname[ROANIX_UTSNAME_FIELD_SIZE];
+    char nodename[ROANIX_UTSNAME_FIELD_SIZE];
+    char release[ROANIX_UTSNAME_FIELD_SIZE];
+    char version[ROANIX_UTSNAME_FIELD_SIZE];
+    char machine[ROANIX_UTSNAME_FIELD_SIZE];
+    char domainname[ROANIX_UTSNAME_FIELD_SIZE];
+};
+
+struct roanix_stat {
+    uint64_t device;
+    uint64_t inode;
+    uint32_t mode;
+    uint32_t kind;
+    uint64_t links;
+    uint64_t size;
+    uint64_t accessed_ns;
+    uint64_t modified_ns;
+    uint64_t changed_ns;
+    uint64_t rdev; /* Requested with statat bit 31. */
+};
+
+/* Filesystem accounting uses the supplied block size, not host page units. */
+#define ROANIX_DEVFS_MAGIC UINT64_C(0x52444556)
+/* Native local-socket records. Names exclude sockaddr family and terminators.
+ * Address kinds: 0 unnamed/autobind, 1 pathname, 2 abstract, 3 disconnect.
+ * Message flags: 1 payload truncated, 2 credentials present, 4 rights truncated.
+ * Syscall flag 16 selects the extended record with descriptor fields; without
+ * it only the original first 40 bytes are read. Receive flag 32 requests CLOEXEC.
+ * rights_count is the send count, or receive capacity replaced by actual count. */
+struct roanix_socket_address { uint32_t kind, length; uint8_t name[108]; };
+struct roanix_socket_credentials { uint64_t pid; uint32_t uid, gid; };
+struct roanix_socket_message {
+    uint64_t address, iov, iov_count, credentials, flags;
+    uint64_t rights, rights_count;
+};
+#define ROANIX_SOCKET_MAX_RIGHTS 64
+
+/* waitid returns native wait status; libc constructs its siginfo_t. */
+struct roanix_wait_result {
+    uint64_t pid;
+    int32_t status;
+    uint32_t reserved;
+};
+
+struct roanix_statfs {
+    uint64_t filesystem_type;
+    uint64_t block_size;
+    uint64_t blocks;
+    uint64_t blocks_free;
+    uint64_t blocks_available;
+    uint64_t files;
+    uint64_t files_free;
+    uint64_t filesystem_id;
+    uint64_t name_max;
+    uint64_t flags;
+};
+
+typedef long roanix_syscall_word_t;
+
+#if defined(__x86_64__)
+
+static inline roanix_syscall_word_t roanix_syscall0(long number) {
+    register long result __asm__("rax") = number;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        :
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall1(long number, long a0) {
+    register long result __asm__("rax") = number;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall2(long number, long a0, long a1) {
+    register long result __asm__("rax") = number;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall3(
+        long number, long a0, long a1, long a2) {
+    register long result __asm__("rax") = number;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1), "d"(a2)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall4(
+        long number, long a0, long a1, long a2, long a3) {
+    register long result __asm__("rax") = number;
+    register long arg3 __asm__("r10") = a3;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1), "d"(a2), "r"(arg3)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall5(
+        long number, long a0, long a1, long a2, long a3, long a4) {
+    register long result __asm__("rax") = number;
+    register long arg3 __asm__("r10") = a3;
+    register long arg4 __asm__("r8") = a4;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1), "d"(a2), "r"(arg3), "r"(arg4)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+static inline roanix_syscall_word_t roanix_syscall6(
+        long number, long a0, long a1, long a2, long a3, long a4, long a5) {
+    register long result __asm__("rax") = number;
+    register long arg3 __asm__("r10") = a3;
+    register long arg4 __asm__("r8") = a4;
+    register long arg5 __asm__("r9") = a5;
+    __asm__ volatile("syscall"
+        : "+a"(result)
+        : "D"(a0), "S"(a1), "d"(a2), "r"(arg3), "r"(arg4), "r"(arg5)
+        : "rcx", "r11", "memory");
+    return result;
+}
+
+#elif defined(__riscv) && __riscv_xlen == 64
+
+static inline roanix_syscall_word_t roanix_syscall6(
+        long number, long a0, long a1, long a2, long a3, long a4, long a5) {
+    register long x10 __asm__("a0") = a0;
+    register long x11 __asm__("a1") = a1;
+    register long x12 __asm__("a2") = a2;
+    register long x13 __asm__("a3") = a3;
+    register long x14 __asm__("a4") = a4;
+    register long x15 __asm__("a5") = a5;
+    register long x17 __asm__("a7") = number;
+    __asm__ volatile("ecall"
+        : "+r"(x10)
+        : "r"(x11), "r"(x12), "r"(x13), "r"(x14), "r"(x15), "r"(x17)
+        : "memory");
+    return x10;
+}
+
+static inline roanix_syscall_word_t roanix_syscall5(
+        long number, long a0, long a1, long a2, long a3, long a4) {
+    return roanix_syscall6(number, a0, a1, a2, a3, a4, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall4(
+        long number, long a0, long a1, long a2, long a3) {
+    return roanix_syscall6(number, a0, a1, a2, a3, 0, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall3(
+        long number, long a0, long a1, long a2) {
+    return roanix_syscall6(number, a0, a1, a2, 0, 0, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall2(long number, long a0, long a1) {
+    return roanix_syscall6(number, a0, a1, 0, 0, 0, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall1(long number, long a0) {
+    return roanix_syscall6(number, a0, 0, 0, 0, 0, 0);
+}
+
+static inline roanix_syscall_word_t roanix_syscall0(long number) {
+    return roanix_syscall6(number, 0, 0, 0, 0, 0, 0);
+}
+
+#else
+#error "Roanix supports only x86_64 and riscv64"
+#endif
+
+#endif
