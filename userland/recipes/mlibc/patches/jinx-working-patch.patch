+int Sysdeps<Sleep>::operator()(time_t *seconds, long *nanoseconds) {
+    if (*seconds < 0 || *nanoseconds < 0 || *nanoseconds >= 1000000000)
+        return EINVAL;
+    time_t started_seconds;
+    long started_nanoseconds;
+    bool timed = !Sysdeps<ClockGet>::operator()(CLOCK_MONOTONIC,
+        &started_seconds, &started_nanoseconds);
+    int error = syscall_error(roanix_syscall2(
+        ROANIX_SYS_CLOCK_SLEEP, *seconds, *nanoseconds));
+    if (!error) {
+        *seconds = 0;
+        *nanoseconds = 0;
+    } else if (error == EINTR && timed) {
+        time_t now_seconds;
+        long now_nanoseconds;
+        if (!Sysdeps<ClockGet>::operator()(CLOCK_MONOTONIC, &now_seconds, &now_nanoseconds)) {
+            time_t elapsed_seconds = now_seconds - started_seconds;
+            long elapsed_nanoseconds = now_nanoseconds - started_nanoseconds;
+            if (elapsed_nanoseconds < 0) {
+                --elapsed_seconds;
+                elapsed_nanoseconds += 1000000000;
+            }
+            if (elapsed_seconds > *seconds
+                    || (elapsed_seconds == *seconds && elapsed_nanoseconds >= *nanoseconds)) {
+                *seconds = 0;
+                *nanoseconds = 0;
+            } else {
+                *seconds -= elapsed_seconds;
+                *nanoseconds -= elapsed_nanoseconds;
+                if (*nanoseconds < 0) {
+                    --*seconds;
+                    *nanoseconds += 1000000000;
+                }
+            }
+        }
+    }
+    return error;
+}
