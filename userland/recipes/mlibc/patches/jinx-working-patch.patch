+int Sysdeps<PrepareStack>::operator()(
+        void **stack,
+        void *entry,
+        void *user_arg,
+        void *tcb,
+        size_t *stack_size,
+        size_t *guard_size,
+        void **stack_base) {
+    constexpr size_t default_stack_size = 2 * 1024 * 1024;
+    constexpr size_t page_size = 0x1000;
+    if (!*stack_size)
+        *stack_size = default_stack_size;
+    *stack_size = (*stack_size + page_size - 1) & ~(page_size - 1);
+
+    if (*stack) {
+        // A caller-supplied stack is not ours to carve a guard page out of.
+        *guard_size = 0;
+        *stack_base = *stack;
+    } else {
+        *guard_size = (*guard_size + page_size - 1) & ~(page_size - 1);
+        size_t total = *stack_size + *guard_size;
+        if (total < *stack_size)
+            return EINVAL;
+
+        int error = sysdep<VmMap>(
+            nullptr,
+            total,
+            PROT_READ | PROT_WRITE,
+            MAP_PRIVATE | MAP_ANONYMOUS,
+            -1,
+            0,
+            stack_base
+        );
+        if (error)
+            return error;
+
+        // Stacks grow down, so the guard belongs at the low end of the
+        // mapping. Losing the guard is not worth failing thread creation
+        // over, so an unsupported mprotect just leaves the stack unguarded.
+        if (*guard_size) {
+            if (mlibc::sysdep_or_enosys<VmProtect>(*stack_base, *guard_size, PROT_NONE))
+                *guard_size = 0;
+            else
+                *stack_base = reinterpret_cast<char *>(*stack_base) + *guard_size;
+        }
+    }
+
+    uintptr_t top =
+        reinterpret_cast<uintptr_t>(*stack_base) + *stack_size;
+    top &= ~uintptr_t{15};
+    if (top < reinterpret_cast<uintptr_t>(*stack_base) + 3 * sizeof(uintptr_t))
+        return EINVAL;
+
+    auto pointer = reinterpret_cast<uintptr_t *>(top);
+    *--pointer = reinterpret_cast<uintptr_t>(tcb);
+    *--pointer = reinterpret_cast<uintptr_t>(user_arg);
+    *--pointer = reinterpret_cast<uintptr_t>(entry);
+    *stack = pointer;
+    return 0;
+}
