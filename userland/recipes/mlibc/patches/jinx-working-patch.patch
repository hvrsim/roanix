index 4abb00d..2bffe59 100644
--- mlibc-clean/options/glibc/generic/printf.cpp
+++ mlibc-workdir/options/glibc/generic/printf.cpp
@@ -1,7 +1,100 @@
-#include <bits/ensure.h>
 #include <printf.h>
+#include <stdint.h>
+#include <stddef.h>
 
-size_t parse_printf_format(const char * __restrict, size_t, int * __restrict) {
-	__ensure(!"Not implemented");
-	__builtin_unreachable();
+namespace {
+bool digit(char c) { return c >= '0' && c <= '9'; }
+
+// Consume decimal digits without allowing a hostile positional index to wrap.
+bool number(const char *&cursor, size_t &value) {
+    value = 0;
+    bool valid = true;
+    while (digit(*cursor)) {
+        unsigned d = *cursor++ - '0';
+        if (value > (SIZE_MAX - d) / 10) valid = false;
+        else if (valid) value = value * 10 + d;
+    }
+    return valid;
+}
+
+// Return SIZE_MAX for a sequential argument; positions in the format are one based.
+size_t position(const char *&cursor) {
+    const char *start = cursor;
+    if (!digit(*cursor)) return SIZE_MAX;
+    size_t value;
+    bool valid = number(cursor, value);
+    if (*cursor == '$' && valid && value != 0) { ++cursor; return value - 1; }
+    cursor = start;
+    return SIZE_MAX;
+}
+int integer_size(size_t size) {
+    if (size > sizeof(int) && size == sizeof(long)) return PA_FLAG_LONG;
+    if (size > sizeof(int)) return PA_FLAG_LONG_LONG;
+    return 0;
+}
+}
+
+size_t parse_printf_format(const char *__restrict format, size_t capacity, int *__restrict types) {
+    size_t next = 0, total = 0;
+    auto argument = [&](size_t index, int type) {
+        if (index == SIZE_MAX) index = next++;
+        if (index < capacity) types[index] = type;
+        if (index + 1 > total) total = index + 1;
+    };
+    const char *p = format;
+    while (*p) {
+        if (*p++ != '%') continue;
+        if (*p == '%') { ++p; continue; }
+        size_t index = position(p);
+        while (*p && (*p == '#' || *p == '0' || *p == '-' || *p == ' ' ||
+                      *p == '+' || *p == '\'' || *p == 'I')) ++p;
+        if (*p == '*') { ++p; argument(position(p), PA_INT); }
+        else { size_t ignored; number(p, ignored); }
+        if (*p == '.') {
+            ++p;
+            if (*p == '*') { ++p; argument(position(p), PA_INT); }
+            else { size_t ignored; number(p, ignored); }
+        }
+        int modifier = 0;
+        bool long_double = false;
+        switch (*p) {
+            case 'h':
+                ++p;
+                if (*p == 'h') { ++p; modifier = PA_CHAR; }
+                else modifier = PA_FLAG_SHORT;
+                break;
+            case 'l':
+                ++p;
+                if (*p == 'l') { ++p; modifier = integer_size(sizeof(long long)); }
+                else modifier = integer_size(sizeof(long));
+                break;
+            // glibc's introspection treats legacy q/L integer conversions as
+            // PA_INT, while their floating conversions use long double.
+            case 'q': case 'L': ++p; long_double = true; break;
+            case 'j': ++p; modifier = integer_size(sizeof(intmax_t)); break;
+            case 'z': case 'Z': ++p; modifier = integer_size(sizeof(size_t)); break;
+            case 't': ++p; modifier = integer_size(sizeof(ptrdiff_t)); break;
+        }
+        if (!*p) break;
+        int type;
+        switch (*p++) {
+            case 'd': case 'i': case 'u': case 'o': case 'x': case 'X': case 'b': case 'B':
+                type = modifier == PA_CHAR ? PA_CHAR : PA_INT | modifier;
+                break;
+            case 'c': type = PA_CHAR; break;
+            case 'C': type = PA_WCHAR; break;
+            case 's': type = PA_STRING; break;
+            case 'S': type = PA_WSTRING; break;
+            case 'p': type = PA_POINTER; break;
+            case 'n': type = PA_INT | PA_FLAG_PTR; break;
+            case 'e': case 'E': case 'f': case 'F': case 'g': case 'G': case 'a': case 'A':
+                type = PA_DOUBLE | (long_double ? PA_FLAG_LONG_DOUBLE : 0);
+                break;
+            // %% and GNU %m consume no value. Unknown conversions have no
+            // registered extension handler in mlibc, so consume no value either.
+            default: continue;
+        }
+        argument(index, type);
+    }
+    return total;
 }
