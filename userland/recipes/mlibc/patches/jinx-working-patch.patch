+int Sysdeps<Reboot>::operator()(int command) {
+    long action;
+    switch (static_cast<unsigned int>(command)) {
+        case RB_HALT_SYSTEM: action = ROANIX_POWER_HALT; break;
+        case RB_AUTOBOOT: action = ROANIX_POWER_REBOOT; break;
+        case RB_POWER_OFF: action = ROANIX_POWER_OFF; break;
+        case RB_ENABLE_CAD:
