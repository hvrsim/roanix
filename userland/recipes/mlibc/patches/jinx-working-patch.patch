+int Sysdeps<Pselect>::operator()(
+        int num_fds,
+        fd_set *read_set,
+        fd_set *write_set,
+        fd_set *except_set,
+        const struct timespec *timeout,
+        const sigset_t *,
+        int *num_events) {
+    if (num_fds < 0 || num_fds > FD_SETSIZE)
+        return EINVAL;
+    int timeout_ms = -1;
+    if (timeout) {
+        if (timeout->tv_sec < 0
+                || timeout->tv_nsec < 0
+                || timeout->tv_nsec >= 1000000000)
+            return EINVAL;
+        if (timeout->tv_sec > INT_MAX / 1000) {
+            timeout_ms = INT_MAX;
+        } else {
+            unsigned long long milliseconds =
+                static_cast<unsigned long long>(timeout->tv_sec) * 1000
+                + (static_cast<unsigned long long>(timeout->tv_nsec) + 999999) / 1000000;
+            timeout_ms = milliseconds > INT_MAX
+                ? INT_MAX
+                : static_cast<int>(milliseconds);
+        }
+    }
+
+    struct pollfd poll_fds[FD_SETSIZE];
+    int poll_count = 0;
+    for (int fd = 0; fd < num_fds; fd++) {
+        unsigned char mask = 1u << (fd % 8);
+        bool readable = read_set
+            && (read_set->fds_bits[fd / 8] & mask);
+        bool writable = write_set
+            && (write_set->fds_bits[fd / 8] & mask);
+        bool exceptional = except_set
+            && (except_set->fds_bits[fd / 8] & mask);
+        short events = 0;
+        if (readable)
+            events |= POLLIN;
+        if (writable)
+            events |= POLLOUT;
+        if (exceptional)
+            events |= POLLPRI;
+        if (!events)
+            continue;
+        poll_fds[poll_count].fd = fd;
+        poll_fds[poll_count].events = events;
+        poll_fds[poll_count].revents = 0;
+        poll_count++;
+    }
+
+    int polled;
+    int error = sysdep<Poll>(
+        poll_fds,
+        static_cast<nfds_t>(poll_count),
+        timeout_ms,
+        &polled
+    );
+    if (error)
+        return error;
+
+    if (read_set)
+        memset(read_set, 0, sizeof(*read_set));
+    if (write_set)
+        memset(write_set, 0, sizeof(*write_set));
+    if (except_set)
+        memset(except_set, 0, sizeof(*except_set));
+
+    int ready = 0;
+    for (int index = 0; index < poll_count; index++) {
+        const auto &entry = poll_fds[index];
+        if (entry.revents & POLLNVAL)
+            return EBADF;
+        unsigned char mask = 1u << (entry.fd % 8);
+        bool descriptor_ready = false;
+        if (read_set
+                && entry.events & POLLIN
+                && entry.revents & (POLLIN | POLLHUP | POLLERR)) {
+            read_set->fds_bits[entry.fd / 8] |= mask;
+            descriptor_ready = true;
+        }
+        if (write_set
+                && entry.events & POLLOUT
+                && entry.revents & (POLLOUT | POLLERR)) {
+            write_set->fds_bits[entry.fd / 8] |= mask;
+            descriptor_ready = true;
+        }
+        if (except_set
+                && entry.events & POLLPRI
+                && entry.revents & POLLPRI) {
+            except_set->fds_bits[entry.fd / 8] |= mask;
+            descriptor_ready = true;
+        }
+        if (descriptor_ready)
+            ready++;
+    }
+    *num_events = ready;
+    return 0;
+}
+
+int Sysdeps<Fchmod>::operator()(int fd, mode_t mode) {
+    return syscall_error(roanix_syscall2(
+        ROANIX_SYS_FILE_FCHMOD, fd, mode));
+}
+
+int Sysdeps<Ttyname>::operator()(int fd, char *buffer, size_t size) {
+    int error = Sysdeps<Isatty>::operator()(fd);
+    if (error)
+        return error;
+    constexpr unsigned long kTiocgpath = 0x52540001;
+    char path[32];
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, kTiocgpath, as_word(path));
+    error = syscall_error(result);
+    if (error)
+        return error;
+    size_t length = strlen(path) + 1;
+    if (size < length)
+        return ERANGE;
+    memcpy(buffer, path, length);
+    return 0;
+}
+
+int Sysdeps<GetLoginR>::operator()(char *buffer, size_t size) {
+    const char login[] = "root";
+    if (size < sizeof(login))
+        return ERANGE;
+    memcpy(buffer, login, sizeof(login));
+    return 0;
+}
+
+int Sysdeps<Isatty>::operator()(int fd) {
+    struct termios settings;
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL,
+        fd,
+        kTcgets,
+        as_word(&settings)
+    );
+    return syscall_error(result);
+}
+
+int Sysdeps<Ioctl>::operator()(
+        int fd, unsigned long request, void *argument, int *result_out) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL,
+        fd,
+        request,
+        as_word(argument)
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *result_out = static_cast<int>(result);
+    return error;
+}
+
+int Sysdeps<Ptsname>::operator()(int fd, char *buffer, size_t length) {
+    unsigned int index;
+    int result;
+    int error = sysdep<Ioctl>(fd, kTiocgptn, &index, &result);
+    if (error)
+        return error;
+
+    char digits[10];
+    size_t count = 0;
+    do {
+        digits[count++] = static_cast<char>('0' + index % 10);
+        index /= 10;
+    } while (index);
+
+    constexpr char prefix[] = "/dev/pts/";
+    size_t required = sizeof(prefix) - 1 + count + 1;
+    if (length < required)
+        return ERANGE;
+    memcpy(buffer, prefix, sizeof(prefix) - 1);
+    for (size_t position = 0; position < count; ++position)
+        buffer[sizeof(prefix) - 1 + position] = digits[count - position - 1];
+    buffer[required - 1] = '\0';
+    return 0;
+}
+
+int Sysdeps<Unlockpt>::operator()(int fd) {
+    int unlock = 0;
+    int result;
+    return sysdep<Ioctl>(fd, kTiocsptlck, &unlock, &result);
+}
+
+int Sysdeps<Tcgetattr>::operator()(int fd, struct termios *settings) {
+    return syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, kTcgets, as_word(settings)));
+}
+
+int Sysdeps<Tcsetattr>::operator()(
+        int fd, int action, const struct termios *settings) {
+    unsigned long request;
+    switch (action) {
+        case TCSANOW: request = kTcsets; break;
+        case TCSADRAIN: request = kTcsetsw; break;
+        case TCSAFLUSH: request = kTcsetsf; break;
+        default: return EINVAL;
+    }
+    return syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, request, as_word(settings)));
+}
+
+int Sysdeps<Tcsendbreak>::operator()(int fd, int duration) {
+    (void)duration;
+    return syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, kTcsbrk, 0));
+}
+
+int Sysdeps<Tcflow>::operator()(int fd, int action) {
+    return syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, kTcxonc, action));
+}
+
+int Sysdeps<Tcflush>::operator()(int fd, int queue) {
+    return syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, kTcflsh, queue));
+}
+
+int Sysdeps<Tcdrain>::operator()(int fd) {
+    return syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, kTcsbrk, 1));
+}
+
+int Sysdeps<Tcgetwinsize>::operator()(int fd, struct winsize *size) {
+    return syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, kTiocgwinsz, as_word(size)));
+}
+
+int Sysdeps<Tcsetwinsize>::operator()(int fd, const struct winsize *size) {
+    return syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_IOCTL, fd, kTiocswinsz, as_word(size)));
+}
+
+int Sysdeps<Read>::operator()(
+        int fd, void *buffer, size_t size, ssize_t *bytes_read) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_READ,
+        fd,
+        as_word(buffer),
+        size
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *bytes_read = result;
+    return error;
+}
+
+int Sysdeps<Write>::operator()(
+        int fd, const void *buffer, size_t size, ssize_t *bytes_written) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_WRITE,
+        fd,
+        as_word(buffer),
+        size
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *bytes_written = result;
+    return error;
+}
+
+int Sysdeps<Seek>::operator()(
+        int fd, off_t offset, int whence, off_t *new_offset) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_FILE_SEEK,
+        fd,
+        offset,
+        whence
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *new_offset = result;
+    return error;
+}
+
+int Sysdeps<ClockGet>::operator()(
+        int clock, time_t *seconds, long *nanoseconds) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_CLOCK_GET,
+        clock,
+        as_word(seconds),
+        as_word(nanoseconds)
+    );
+    return syscall_error(result);
+}
+
+int Sysdeps<VmMap>::operator()(
+        void *hint,
+        size_t size,
+        int protection,
+        int flags,
+        int fd,
+        off_t offset,
+        void **window) {
+    long result = roanix_syscall6(
+        ROANIX_SYS_MEMORY_MAP,
+        as_word(hint),
+        size,
+        protection,
+        flags,
+        fd,
+        offset
+    );
+    int error = syscall_error(result);
+    if (!error)
+        *window = reinterpret_cast<void *>(result);
+    return error;
+}
+
+int Sysdeps<VmUnmap>::operator()(void *pointer, size_t size) {
+    long result = roanix_syscall2(
+        ROANIX_SYS_MEMORY_UNMAP,
+        as_word(pointer),
+        size
+    );
+    return syscall_error(result);
+}
+
+} // namespace mlibc
