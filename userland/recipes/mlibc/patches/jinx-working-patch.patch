+int Sysdeps<Stat>::operator()(
+        mlibc::fsfd_target target,
+        int fd,
+        const char *path,
+        int flags,
+        struct stat *output) {
+    struct roanix_stat source;
+    long result;
+    if (target == mlibc::fsfd_target::fd) {
+        result = roanix_syscall4(
+            ROANIX_SYS_FILE_STATAT, fd, as_word(""), AT_EMPTY_PATH | (1U << 31), as_word(&source));
+    } else if (target == mlibc::fsfd_target::path) {
+        result = roanix_syscall4(
+            ROANIX_SYS_FILE_STATAT,
+            AT_FDCWD,
+            as_word(path),
+            static_cast<unsigned>(flags) | (1U << 31),
+            as_word(&source)
+        );
+    } else if (target == mlibc::fsfd_target::fd_path) {
+        result = roanix_syscall4(
+            ROANIX_SYS_FILE_STATAT,
+            fd,
+            as_word(path),
+            static_cast<unsigned>(flags) | (1U << 31),
+            as_word(&source)
+        );
+    } else {
+        return ENOSYS;
+    }
+    int error = syscall_error(result);
+    if (!error)
+        fill_stat(source, output);
+    return error;
+}
+
+int Sysdeps<Statx>::operator()(int dirfd, const char *path, int flags,
+        unsigned int mask, struct statx *output) {
+    constexpr int supported = AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT
+        | AT_EMPTY_PATH | AT_STATX_SYNC_TYPE;
+    if ((flags & ~supported) || (flags & AT_STATX_SYNC_TYPE) == AT_STATX_SYNC_TYPE
+            || (mask & 0x80000000U))
+        return EINVAL;
+    if (!path || !output)
+        return EFAULT;
+
+    // Native metadata is local and coherent; the synchronization hints need
+    // no separate fetch. Only advertise fields the native stat supplies.
+    struct stat source;
+    int error = Sysdeps<Stat>::operator()(mlibc::fsfd_target::fd_path,
+        dirfd, path, flags & ~AT_STATX_SYNC_TYPE, &source);
+    if (error)
+        return error;
+    memset(output, 0, sizeof(*output));
+    output->stx_mask = STATX_BASIC_STATS;
+    output->stx_blksize = source.st_blksize;
+    output->stx_nlink = source.st_nlink;
+    output->stx_uid = source.st_uid;
+    output->stx_gid = source.st_gid;
+    output->stx_mode = source.st_mode;
+    output->stx_ino = source.st_ino;
+    output->stx_size = source.st_size;
+    output->stx_blocks = source.st_blocks;
+    output->stx_atime.tv_sec = source.st_atim.tv_sec;
+    output->stx_atime.tv_nsec = source.st_atim.tv_nsec;
+    output->stx_mtime.tv_sec = source.st_mtim.tv_sec;
+    output->stx_mtime.tv_nsec = source.st_mtim.tv_nsec;
+    output->stx_ctime.tv_sec = source.st_ctim.tv_sec;
+    output->stx_ctime.tv_nsec = source.st_ctim.tv_nsec;
+    output->stx_dev_major = major(source.st_dev);
+    output->stx_dev_minor = minor(source.st_dev);
+    output->stx_rdev_major = major(source.st_rdev);
+    output->stx_rdev_minor = minor(source.st_rdev);
+    return 0;
+}
