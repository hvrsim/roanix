+int Sysdeps<PosixMadvise>::operator()(void *address, size_t length, int advice) {
+    // POSIX_MADV_* and MADV_* happen to share values in this ABI, but that is a
+    // coincidence rather than a guarantee, so the advice is translated
+    // explicitly and anything unrecognised is rejected.
+    int translated;
+    switch (advice) {
+        case POSIX_MADV_NORMAL:
+            translated = MADV_NORMAL;
+            break;
+        case POSIX_MADV_RANDOM:
+            translated = MADV_RANDOM;
+            break;
+        case POSIX_MADV_SEQUENTIAL:
+            translated = MADV_SEQUENTIAL;
+            break;
+        case POSIX_MADV_WILLNEED:
+            translated = MADV_WILLNEED;
+            break;
+        case POSIX_MADV_DONTNEED:
+            // POSIX_MADV_DONTNEED must preserve the mapping's contents, while
+            // MADV_DONTNEED discards them. There is no faithful translation, so
+            // the advisory form is accepted and ignored, as glibc also does.
+            return 0;
+        default:
+            return EINVAL;
+    }
+    return Sysdeps<Madvise>::operator()(address, length, translated);
+}
