+int filesystem_stats(int dirfd, const char *path, struct statfs *output) {
+    struct roanix_statfs source;
+    static_assert(sizeof(source) == 80);
+    int error = syscall_error(roanix_syscall3(
+        ROANIX_SYS_FILE_STATFS, dirfd, as_word(path), as_word(&source)));
+    if (error)
+        return error;
+    memset(output, 0, sizeof(*output));
+    output->f_type = source.filesystem_type;
+    output->f_bsize = source.block_size;
+    output->f_blocks = source.blocks;
+    output->f_bfree = source.blocks_free;
+    output->f_bavail = source.blocks_available;
+    output->f_files = source.files;
+    output->f_ffree = source.files_free;
+    output->f_fsid.__val[0] = static_cast<int>(source.filesystem_id & UINT32_MAX);
+    output->f_fsid.__val[1] = static_cast<int>(source.filesystem_id >> 32);
+    output->f_namelen = source.name_max;
+    output->f_frsize = source.block_size;
+    output->f_flags = source.flags;
+    return 0;
+}
+
+int filesystem_vfs_stats(int dirfd, const char *path, struct statvfs *output) {
+    struct statfs source;
+    int error = filesystem_stats(dirfd, path, &source);
+    if (error)
+        return error;
+    memset(output, 0, sizeof(*output));
+    output->f_bsize = source.f_bsize;
+    output->f_frsize = source.f_frsize;
+    output->f_blocks = source.f_blocks;
+    output->f_bfree = source.f_bfree;
+    output->f_bavail = source.f_bavail;
+    output->f_files = source.f_files;
+    output->f_ffree = source.f_ffree;
+    output->f_favail = source.f_ffree;
+    output->f_fsid = static_cast<uint32_t>(source.f_fsid.__val[0])
+        | (static_cast<uint64_t>(static_cast<uint32_t>(source.f_fsid.__val[1])) << 32);
+    output->f_flag = source.f_flags;
+    output->f_namemax = source.f_namelen;
+    return 0;
+}
