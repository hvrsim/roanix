+mode_t file_type(unsigned kind) {
+    switch (kind) {
+        case 1: return S_IFREG;
+        case 2: return S_IFDIR;
+        case 3: return S_IFLNK;
+        case 4: return S_IFCHR;
+        case 5: return S_IFBLK;
+        case 6: return S_IFIFO;
+        case 7: return S_IFSOCK;
+        default: return 0;
+    }
+}
+
+void fill_stat(const struct roanix_stat &source, struct stat *target) {
+    memset(target, 0, sizeof(*target));
+    target->st_dev = source.device;
+    target->st_ino = source.inode;
+    target->st_mode = source.mode | file_type(source.kind);
+    target->st_nlink = source.links;
+    target->st_uid = 0;
+    target->st_gid = 0;
+    target->st_size = source.size;
+    target->st_blksize = 4096;
+    target->st_blocks = (source.size + 511) / 512;
+    target->st_atim.tv_sec = source.accessed_ns / 1000000000;
+    target->st_atim.tv_nsec = source.accessed_ns % 1000000000;
+    target->st_mtim.tv_sec = source.modified_ns / 1000000000;
+    target->st_mtim.tv_nsec = source.modified_ns % 1000000000;
+    target->st_ctim.tv_sec = source.changed_ns / 1000000000;
+    target->st_ctim.tv_nsec = source.changed_ns % 1000000000;
+}
