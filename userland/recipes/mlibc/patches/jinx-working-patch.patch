diff --git mlibc-workdir/sysdeps/roanix/generic/entry.cpp mlibc-workdir/sysdeps/roanix/generic/entry.cpp
new file mode 100644
index 0000000..9e8955e
--- /dev/null
+++ mlibc-workdir/sysdeps/roanix/generic/entry.cpp
@@ -0,0 +1,19 @@
+#include <stdint.h>
+#include <stdlib.h>
+#include <mlibc/elf/startup.h>
+
+extern "C" void __dlapi_enter(uintptr_t *);
+
+extern char **environ;
+
+extern "C" void __mlibc_entry(
+        uintptr_t *entry_stack,
+        int (*main_fn)(int argc, char *argv[], char *env[])) {
+    __dlapi_enter(entry_stack);
+    int result = main_fn(
+        mlibc::entry_stack.argc,
+        mlibc::entry_stack.argv,
+        environ
+    );
+    exit(result);
+}
diff --git mlibc-workdir/sysdeps/roanix/generic/sockets.cpp mlibc-workdir/sysdeps/roanix/generic/sockets.cpp
new file mode 100644
index 0000000..29dd4ad
--- /dev/null
+++ mlibc-workdir/sysdeps/roanix/generic/sockets.cpp
@@ -0,0 +1,326 @@
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <sys/uio.h>
+#include <linux/netlink.h>
+#include <mlibc/all-sysdeps.hpp>
+#include <roanix/syscall.h>
+
+namespace {
+long pointer(const void *p) { return static_cast<long>(reinterpret_cast<uintptr_t>(p)); }
+int error(long result) { return result < 0 && result >= -4095 ? static_cast<int>(-result) : 0; }
+
+int socket_type(int domain, int type, int protocol, unsigned *kind, unsigned *flags) {
+    if (domain == AF_NETLINK) {
+        if (protocol != NETLINK_KOBJECT_UEVENT) return EPROTONOSUPPORT;
+        int base = type & ~(SOCK_NONBLOCK | SOCK_CLOEXEC);
+        if (base != SOCK_RAW && base != SOCK_DGRAM) return ESOCKTNOSUPPORT;
+        *kind = base == SOCK_RAW ? 3 : 4;
+        *flags = (type & SOCK_NONBLOCK ? 1 : 0) | (type & SOCK_CLOEXEC ? 2 : 0);
+        return 0;
+    }
+    if (domain != AF_UNIX) return EAFNOSUPPORT;
+    if (protocol != 0) return EPROTONOSUPPORT;
+    *kind = type & ~(SOCK_NONBLOCK | SOCK_CLOEXEC);
+    *flags = (type & SOCK_NONBLOCK ? 1 : 0) | (type & SOCK_CLOEXEC ? 2 : 0);
+    return 0;
+}
+int encode_address(const sockaddr *address, socklen_t size, roanix_socket_address *out) {
+    if (!address) return EFAULT;
+    if (size < sizeof(sa_family_t)) return EINVAL;
+    sa_family_t family;
+    memcpy(&family, address, sizeof(family));
+    *out = {};
+    if (family == AF_UNSPEC) { out->kind = 3; return 0; }
+    if (family == AF_NETLINK) {
+        if (size != sizeof(sockaddr_nl)) return EINVAL;
+        sockaddr_nl native;
+        memcpy(&native, address, sizeof(native));
+        if (native.nl_pad) return EINVAL;
+        out->kind = 4; out->length = 8;
+        memcpy(out->name, &native.nl_pid, 4);
+        memcpy(out->name + 4, &native.nl_groups, 4);
+        return 0;
+    }
+    if (family != AF_UNIX) return EAFNOSUPPORT;
+    constexpr size_t prefix = offsetof(sockaddr_un, sun_path);
+    if (size < prefix || size > sizeof(sockaddr_un)) return EINVAL;
+    if (size == prefix) return 0;
+    const char *name = reinterpret_cast<const char *>(address) + prefix;
+    size_t length = size - prefix;
+    if (!name[0]) {
+        out->kind = 2;
+        --length; ++name;
+    } else {
+        out->kind = 1;
+        length = strnlen(name, length);
+        if (length > 107) return ENAMETOOLONG;
+    }
+    out->length = length;
+    memcpy(out->name, name, length);
+    return 0;
+}
+int copy_address(const roanix_socket_address &address, sockaddr *out, socklen_t capacity,
+                 socklen_t *actual) {
+    if (address.kind == 4) {
+        sockaddr_nl native = {};
+        native.nl_family = AF_NETLINK;
+        memcpy(&native.nl_pid, address.name, 4);
+        memcpy(&native.nl_groups, address.name + 4, 4);
+        size_t count = capacity < sizeof(native) ? capacity : sizeof(native);
+        if (count && !out) return EFAULT;
+        if (count) memcpy(out, &native, count);
+        *actual = sizeof(native);
+        return 0;
+    }
+    sockaddr_un native = {};
+    native.sun_family = AF_UNIX;
+    size_t length = offsetof(sockaddr_un, sun_path);
+    if (address.kind == 1) {
+        memcpy(native.sun_path, address.name, address.length);
+        length += address.length + 1;
+    } else if (address.kind == 2) {
+        memcpy(native.sun_path + 1, address.name, address.length);
+        length += address.length + 1;
+    }
+    size_t copied = capacity < length ? capacity : length;
+    if (copied && !out) return EFAULT;
+    if (copied) memcpy(out, &native, copied);
+    *actual = length;
+    return 0;
+}
+int name(int fd, bool peer, sockaddr *out, socklen_t capacity, socklen_t *actual) {
+    roanix_socket_address address = {};
+    int e = error(roanix_syscall3(ROANIX_SYS_SOCKET_NAME, fd, peer, pointer(&address)));
+    return e ? e : copy_address(address, out, capacity, actual);
+}
+int option_number(int layer, int number) {
+    if (layer == SOL_NETLINK) {
+        if (number == NETLINK_ADD_MEMBERSHIP) return 20;
+        if (number == NETLINK_DROP_MEMBERSHIP) return 21;
+        return 0;
+    }
+    if (layer != SOL_SOCKET) return 0;
+    switch (number) {
+        case SO_PASSCRED: return 1;
+        case SO_RCVBUF: case SO_RCVBUFFORCE: return 2;
+        case SO_SNDBUF: return 3;
+        case SO_ERROR: return 4;
+        case SO_TYPE: return 5;
+        case SO_ACCEPTCONN: return 6;
+        default: return 0;
+    }
+}
+bool append_control(msghdr *header, size_t capacity, int type, const void *payload, size_t bytes) {
+    size_t used = header->msg_controllen;
+    if (capacity - used < CMSG_LEN(bytes)) return false;
+    size_t space = CMSG_SPACE(bytes);
+    if (space > capacity - used) space = capacity - used;
+    auto *out = static_cast<unsigned char *>(header->msg_control) + used;
+    memset(out, 0, space);
+    cmsghdr cmsg = {};
+    cmsg.cmsg_len = CMSG_LEN(bytes);
+    cmsg.cmsg_level = SOL_SOCKET; cmsg.cmsg_type = type;
+    memcpy(out, &cmsg, sizeof(cmsg));
+    memcpy(out + CMSG_LEN(0), payload, bytes);
+    header->msg_controllen += space;
+    return true;
+}
+
+}
+
+namespace mlibc {
+int Sysdeps<Socket>::operator()(int domain, int type, int protocol, int *fd) {
+    unsigned kind, flags;
+    if (int e = socket_type(domain, type, protocol, &kind, &flags)) return e;
+    long result = roanix_syscall2(ROANIX_SYS_SOCKET_CREATE, kind, flags);
+    int e = error(result);
+    if (!e) *fd = result;
+    return e;
+}
+int Sysdeps<Socketpair>::operator()(int domain, int type, int protocol, int *fds) {
+    if (domain != AF_UNIX) return EAFNOSUPPORT;
+    unsigned kind, flags;
+    if (int e = socket_type(domain, type, protocol, &kind, &flags)) return e;
+    return error(roanix_syscall3(ROANIX_SYS_SOCKET_PAIR, kind, flags, pointer(fds)));
+}
+int Sysdeps<Bind>::operator()(int fd, const sockaddr *address, socklen_t size) {
+    roanix_socket_address native;
+    if (int e = encode_address(address, size, &native)) return e;
+    return error(roanix_syscall2(ROANIX_SYS_SOCKET_BIND, fd, pointer(&native)));
+}
+int Sysdeps<Listen>::operator()(int fd, int backlog) {
+    return error(roanix_syscall2(ROANIX_SYS_SOCKET_LISTEN, fd, backlog < 0 ? 0 : backlog));
+}
+int Sysdeps<Accept>::operator()(int fd, int *newfd, sockaddr *out, socklen_t *size, int flags) {
+    if (flags & ~(SOCK_NONBLOCK | SOCK_CLOEXEC)) return EINVAL;
+    if (out && !size) return EFAULT;
+    roanix_socket_address address = {};
+    long result = roanix_syscall3(ROANIX_SYS_SOCKET_ACCEPT, fd,
+        (flags & SOCK_NONBLOCK ? 1 : 0) | (flags & SOCK_CLOEXEC ? 2 : 0), out ? pointer(&address) : 0);
+    if (int e = error(result)) return e;
+    if (out) {
+        if (int e = copy_address(address, out, *size, size)) {
+            roanix_syscall1(ROANIX_SYS_FILE_CLOSE, result); return e;
+        }
+    }
+    *newfd = result;
+    return 0;
+}
+int Sysdeps<Connect>::operator()(int fd, const sockaddr *address, socklen_t size) {
+    roanix_socket_address native;
+    if (int e = encode_address(address, size, &native)) return e;
+    return error(roanix_syscall2(ROANIX_SYS_SOCKET_CONNECT, fd, pointer(&native)));
+}
+int Sysdeps<Sockname>::operator()(int fd, sockaddr *out, socklen_t size, socklen_t *actual) {
+    return name(fd, false, out, size, actual);
+}
+int Sysdeps<Peername>::operator()(int fd, sockaddr *out, socklen_t size, socklen_t *actual) {
+    return name(fd, true, out, size, actual);
+}
+int Sysdeps<Shutdown>::operator()(int fd, int how) {
+    return error(roanix_syscall2(ROANIX_SYS_SOCKET_SHUTDOWN, fd, how));
+}
+int Sysdeps<GetSockopt>::operator()(int fd, int layer, int number, void *buffer, socklen_t *size) {
+    if (!size) return EFAULT;
+    if (layer == SOL_SOCKET && number == SO_PEERCRED) {
+        roanix_socket_credentials credentials = {};
+        if (int e = error(roanix_syscall2(ROANIX_SYS_SOCKET_PEERCRED, fd, pointer(&credentials)))) return e;
+        ucred value = {static_cast<pid_t>(credentials.pid), credentials.uid, credentials.gid};
+        size_t count = *size < sizeof(value) ? *size : sizeof(value);
+        if (count && !buffer) return EFAULT;
+        if (count) memcpy(buffer, &value, count);
+        *size = count;
+        return 0;
+    }
+    int option = option_number(layer, number);
+    if (!option) return ENOPROTOOPT;
+    long result = roanix_syscall4(ROANIX_SYS_SOCKET_OPTION, fd, option, 0, 0);
+    if (int e = error(result)) return e;
+    int value = result;
+    size_t count = *size < sizeof(value) ? *size : sizeof(value);
+    if (count && !buffer) return EFAULT;
+    if (count) memcpy(buffer, &value, count);
+    *size = count;
+    return 0;
+}
+int Sysdeps<SetSockopt>::operator()(int fd, int layer, int number, const void *buffer, socklen_t size) {
+    int option = option_number(layer, number);
+    if (!option) return ENOPROTOOPT;
+    if (size < sizeof(int)) return EINVAL;
+    if (!buffer) return EFAULT;
+    int value;
+    memcpy(&value, buffer, sizeof(value));
+    return error(roanix_syscall4(ROANIX_SYS_SOCKET_OPTION, fd, option, 1, value));
+}
+int Sysdeps<MsgSend>::operator()(int fd, const msghdr *header, int flags, ssize_t *length) {
+    if (!header) return EFAULT;
+    if (flags & ~(MSG_DONTWAIT | MSG_NOSIGNAL)) return EOPNOTSUPP;
+    roanix_socket_address address;
+    roanix_socket_credentials credentials = {};
+    roanix_socket_message message = {};
+    if (header->msg_name) {
+        if (int e = encode_address(static_cast<const sockaddr *>(header->msg_name), header->msg_namelen, &address)) return e;
+        if (address.kind == 3) return EINVAL;
+        message.address = pointer(&address);
+    }
+    static_assert(sizeof(iovec) == 16 && offsetof(iovec, iov_len) == 8);
+    message.iov = pointer(header->msg_iov);
+    message.iov_count = header->msg_iovlen;
+    if (header->msg_controllen > 4096) return EINVAL;
+    if (header->msg_controllen && !header->msg_control) return EFAULT;
+    const auto *control = static_cast<const unsigned char *>(header->msg_control);
+    int rights[ROANIX_SOCKET_MAX_RIGHTS];
+    size_t right_count = 0;
+    size_t remaining = header->msg_controllen;
+    while (remaining >= sizeof(cmsghdr)) {
+        cmsghdr cmsg;
+        memcpy(&cmsg, control, sizeof(cmsg));
+        if (cmsg.cmsg_len < CMSG_LEN(0) || cmsg.cmsg_len > remaining) return EINVAL;
+        if (cmsg.cmsg_level != SOL_SOCKET) return EINVAL;
+        if (cmsg.cmsg_type == SCM_RIGHTS) {
+            size_t bytes = cmsg.cmsg_len - CMSG_LEN(0);
+            if (bytes % sizeof(int)) return EINVAL;
+            size_t count = bytes / sizeof(int);
+            if (count > ROANIX_SOCKET_MAX_RIGHTS - right_count) return EMSGSIZE;
+            memcpy(rights + right_count, control + CMSG_LEN(0), bytes);
+            right_count += count;
+        } else {
+            if (cmsg.cmsg_type != SCM_CREDENTIALS || cmsg.cmsg_len != CMSG_LEN(sizeof(ucred))) return EINVAL;
+            ucred cred;
+            memcpy(&cred, control + CMSG_LEN(0), sizeof(cred));
+            credentials.pid = cred.pid; credentials.uid = cred.uid; credentials.gid = cred.gid;
+            message.credentials = pointer(&credentials);
+        }
+        size_t aligned = CMSG_ALIGN(cmsg.cmsg_len);
+        if (aligned > remaining) break;
+        remaining -= aligned; control += aligned;
+    }
+    message.rights = pointer(rights); message.rights_count = right_count;
+    long result = roanix_syscall3(ROANIX_SYS_SOCKET_SEND, fd, pointer(&message),
+        16 | (flags & MSG_DONTWAIT ? 1 : 0) | (flags & MSG_NOSIGNAL ? 8 : 0));
+    int e = error(result);
+    if (!e) *length = result;
+    return e;
+}
+int Sysdeps<MsgRecv>::operator()(int fd, msghdr *header, int flags, ssize_t *length) {
+    if (!header) return EFAULT;
+    if (flags & ~(MSG_DONTWAIT | MSG_PEEK | MSG_TRUNC | MSG_CMSG_CLOEXEC)) return EOPNOTSUPP;
+    if (header->msg_controllen && !header->msg_control) return EFAULT;
+    roanix_socket_address address = {};
+    roanix_socket_credentials credentials = {};
+    roanix_socket_message message = {};
+    int rights[ROANIX_SOCKET_MAX_RIGHTS];
+    size_t capacity = header->msg_controllen;
+    // Rights have priority in this control buffer. Every installed descriptor
+    // must be reported; credentials that do not fit are explicitly truncated.
+    size_t count = capacity >= CMSG_LEN(sizeof(int)) ? (capacity - CMSG_LEN(0)) / sizeof(int) : 0;
+    if (count > ROANIX_SOCKET_MAX_RIGHTS) count = ROANIX_SOCKET_MAX_RIGHTS;
+    message.rights = pointer(rights); message.rights_count = count;
+    message.address = pointer(&address);
+    message.credentials = pointer(&credentials);
+    message.iov = pointer(header->msg_iov);
+    message.iov_count = header->msg_iovlen;
+    long result = roanix_syscall3(ROANIX_SYS_SOCKET_RECEIVE, fd, pointer(&message),
+        16 | (flags & MSG_DONTWAIT ? 1 : 0) | (flags & MSG_PEEK ? 2 : 0) |
+        (flags & MSG_TRUNC ? 4 : 0) | (flags & MSG_CMSG_CLOEXEC ? 32 : 0));
+    if (int e = error(result)) return e;
+    if (header->msg_name) {
+        if (int e = copy_address(address, static_cast<sockaddr *>(header->msg_name), header->msg_namelen, &header->msg_namelen)) return e;
+    } else header->msg_namelen = 0;
+    header->msg_flags = (message.flags & 1 ? MSG_TRUNC : 0) | (message.flags & 4 ? MSG_CTRUNC : 0) | (message.flags & 8 ? MSG_EOR : 0);
+    header->msg_controllen = 0;
+    if (message.rights_count && !append_control(header, capacity, SCM_RIGHTS, rights, message.rights_count * sizeof(int))) {
+        for (size_t i = 0; i < message.rights_count; i++) roanix_syscall1(ROANIX_SYS_FILE_CLOSE, rights[i]);
+        return EIO;
+    }
+    if (message.flags & 2) {
+        ucred cred = {static_cast<pid_t>(credentials.pid), credentials.uid, credentials.gid};
+        if (!append_control(header, capacity, SCM_CREDENTIALS, &cred, sizeof(cred))) header->msg_flags |= MSG_CTRUNC;
+    }
+    *length = result;
+    return 0;
+}
+int Sysdeps<Sendto>::operator()(int fd, const void *buffer, size_t size, int flags,
+        const sockaddr *address, socklen_t address_size, ssize_t *length) {
+    iovec iov = {const_cast<void *>(buffer), size};
+    msghdr header = {};
+    header.msg_name = const_cast<sockaddr *>(address); header.msg_namelen = address_size;
+    header.msg_iov = &iov; header.msg_iovlen = 1;
+    return Sysdeps<MsgSend>::operator()(fd, &header, flags, length);
+}
+int Sysdeps<Recvfrom>::operator()(int fd, void *buffer, size_t size, int flags,
+        sockaddr *address, socklen_t *address_size, ssize_t *length) {
+    if (address && !address_size) return EFAULT;
+    iovec iov = {buffer, size};
+    msghdr header = {};
+    header.msg_name = address; header.msg_namelen = address ? *address_size : 0;
+    header.msg_iov = &iov; header.msg_iovlen = 1;
+    int e = Sysdeps<MsgRecv>::operator()(fd, &header, flags, length);
+    if (!e && address) *address_size = header.msg_namelen;
+    return e;
+}
+} // namespace mlibc
