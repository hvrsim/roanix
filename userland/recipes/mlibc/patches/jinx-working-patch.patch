@@ -0,0 +1,313 @@
+#ifndef ROANIX_SYSCALL_H
+#define ROANIX_SYSCALL_H
+
+#include <stdint.h>
+
+enum roanix_syscall_number {
+    ROANIX_SYS_PROCESS_EXIT = 0,
+    ROANIX_SYS_THREAD_SET_POINTER,
+    ROANIX_SYS_FUTEX_WAIT,
+    ROANIX_SYS_FUTEX_WAKE,
+    ROANIX_SYS_FILE_OPEN,
+    ROANIX_SYS_FILE_CLOSE,
+    ROANIX_SYS_FILE_READ,
+    ROANIX_SYS_FILE_WRITE,
+    ROANIX_SYS_FILE_SEEK,
+    ROANIX_SYS_CLOCK_GET,
+    ROANIX_SYS_MEMORY_MAP,
+    ROANIX_SYS_MEMORY_UNMAP,
+    ROANIX_SYS_FILE_IOCTL,
+    ROANIX_SYS_FILE_DUP,
+    ROANIX_SYS_FILE_DUP2,
+    ROANIX_SYS_PROCESS_FORK,
+    ROANIX_SYS_PROCESS_EXEC,
+    ROANIX_SYS_PROCESS_WAIT,
+    ROANIX_SYS_PROCESS_GETPID,
+    ROANIX_SYS_PROCESS_GETPPID,
+    ROANIX_SYS_PROCESS_GETPGID,
+    ROANIX_SYS_PROCESS_SETPGID,
+    ROANIX_SYS_PROCESS_GETSID,
+    ROANIX_SYS_PROCESS_SETSID,
+    ROANIX_SYS_PROCESS_KILL,
+    ROANIX_SYS_FILE_CHDIR,
+    ROANIX_SYS_FILE_GETCWD,
+    ROANIX_SYS_FILE_ACCESS,
+    ROANIX_SYS_FILE_STAT,
+    ROANIX_SYS_FILE_FSTAT,
+    ROANIX_SYS_FILE_FCNTL,
+    ROANIX_SYS_FILE_PIPE,
+    ROANIX_SYS_FILE_READDIR,
+    ROANIX_SYS_FILE_READLINK,
+    ROANIX_SYS_FILE_UNLINK,
+    ROANIX_SYS_CLOCK_SLEEP,
+    ROANIX_SYS_FILE_MKDIR,
+    ROANIX_SYS_PROCESS_GETTID,
+    ROANIX_SYS_FILE_FCHMOD,
+    ROANIX_SYS_FILE_RENAME,
+    ROANIX_SYS_FILE_POLL,
+    ROANIX_SYS_SYSTEM_UNAME,
+    ROANIX_SYS_SIGNAL_ACTION,
+    ROANIX_SYS_SIGNAL_MASK,
+    ROANIX_SYS_SIGNAL_RETURN,
+    ROANIX_SYS_SIGNAL_FD,
+    ROANIX_SYS_FILE_OPENAT,
+    ROANIX_SYS_FILE_ACCESSAT,
+    ROANIX_SYS_FILE_STATAT,
+    ROANIX_SYS_FILE_READLINKAT,
+    ROANIX_SYS_FILE_UNLINKAT,
+    ROANIX_SYS_FILE_MKDIRAT,
+    ROANIX_SYS_FILE_FCHMODAT,
+    ROANIX_SYS_FILE_RENAMEAT,
+    ROANIX_SYS_FILE_LINKAT,
+    ROANIX_SYS_FILE_SYMLINKAT,
+    ROANIX_SYS_SIGNAL_ALTSTACK,
+    ROANIX_SYS_SIGNAL_PENDING,
+    ROANIX_SYS_SIGNAL_SUSPEND,
+    ROANIX_SYS_SIGNAL_TIMED_WAIT,
+    ROANIX_SYS_EPOLL_CREATE,
+    ROANIX_SYS_EPOLL_CTL,
+    ROANIX_SYS_EPOLL_WAIT,
+    ROANIX_SYS_INOTIFY_INIT,
+    ROANIX_SYS_INOTIFY_ADD,
+    ROANIX_SYS_INOTIFY_REMOVE,
+    ROANIX_SYS_TIMERFD_CREATE,
+    ROANIX_SYS_TIMERFD_SETTIME,
+    ROANIX_SYS_TIMERFD_GETTIME,
+    ROANIX_SYS_THREAD_CREATE,
+    ROANIX_SYS_THREAD_EXIT,
+    ROANIX_SYS_FILE_UMASK,
+    ROANIX_SYS_FILE_UMOUNT,
+    ROANIX_SYS_PROCESS_SETPRIORITY,
+    ROANIX_SYS_PROCESS_GETPRIORITY,
+    ROANIX_SYS_MEMORY_PROTECT,
+    ROANIX_SYS_MEMORY_ADVISE,
+    ROANIX_SYS_THREAD_YIELD,
+    ROANIX_SYS_THREAD_KILL,
+    ROANIX_SYS_THREAD_SET_NAME,
+    ROANIX_SYS_THREAD_GET_NAME,
+    ROANIX_SYS_FILE_MOUNT,
+    ROANIX_SYS_EVENTFD_CREATE,
+    ROANIX_SYS_FILE_STATFS,
+    ROANIX_SYS_PROCESS_WAITID,
+    ROANIX_SYS_SOCKET_CREATE,
+    ROANIX_SYS_SOCKET_PAIR,
+    ROANIX_SYS_SOCKET_BIND,
+    ROANIX_SYS_SOCKET_CONNECT,
+    ROANIX_SYS_SOCKET_NAME,
+    ROANIX_SYS_SOCKET_OPTION,
+    ROANIX_SYS_SOCKET_SHUTDOWN,
+    ROANIX_SYS_SOCKET_SEND,
+    ROANIX_SYS_SOCKET_RECEIVE,
+    ROANIX_SYS_SOCKET_LISTEN,
+    ROANIX_SYS_SOCKET_ACCEPT,
+    ROANIX_SYS_SOCKET_PEERCRED,
+    ROANIX_SYS_SYSTEM_POWER,
