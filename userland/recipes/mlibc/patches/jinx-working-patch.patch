+int Sysdeps<GetEntropy>::operator()(void *buffer, size_t length) {
+    int fd;
+    int error = sysdep<Open>("/dev/urandom", O_RDONLY, 0, &fd);
+    if (error)
+        return error;
+
+    auto output = static_cast<unsigned char *>(buffer);
+    size_t offset = 0;
+    while (offset < length) {
+        ssize_t bytes_read;
+        error = sysdep<Read>(fd, output + offset, length - offset, &bytes_read);
+        if (error)
+            break;
+        if (!bytes_read) {
+            error = EIO;
+            break;
+        }
+        offset += static_cast<size_t>(bytes_read);
+    }
+
+    int close_error = sysdep<Close>(fd);
+    return error ? error : close_error;
+}
