index 0000000..2e85c93
--- /dev/null
+++ mlibc-workdir/sysdeps/roanix/generic/thread.cpp
@@ -0,0 +1,70 @@
+// Threading sysdeps for Roanix.
+//
+// The rest of the roanix sysdeps live in generic/sysdeps.cpp. Thread support is
+// kept here so the two can be worked on independently.
+
+#include <errno.h>
+#include <string.h>
+
+#include <bits/ensure.h>
+#include <mlibc/all-sysdeps.hpp>
+#include <mlibc/tcb.hpp>
+#include <roanix/syscall.h>
+
+namespace {
+
+constexpr bool syscall_failed(long result) {
+    return result < 0 && result >= -4095;
+}
+
+int syscall_error(long result) {
+    return syscall_failed(result) ? static_cast<int>(-result) : 0;
+}
+
+long as_word(const void *pointer) {
+    return static_cast<long>(reinterpret_cast<uintptr_t>(pointer));
+}
+
+// The kernel addresses threads by the identifier it returned from
+// thread_create, which mlibc stores in the TCB.
+int tcb_tid(void *tcb) {
+    return reinterpret_cast<Tcb *>(tcb)->tid;
+}
+
+} // namespace
+
+namespace mlibc {
+
+void Sysdeps<Yield>::operator()() {
+    roanix_syscall0(ROANIX_SYS_THREAD_YIELD);
+}
+
+int Sysdeps<Tgkill>::operator()(int tgid, int tid, int sig) {
+    if (tgid < 0 || tid < 0)
+        return EINVAL;
+    long result = roanix_syscall3(ROANIX_SYS_THREAD_KILL, tgid, tid, sig);
+    return syscall_error(result);
+}
+
+int Sysdeps<ThreadSetname>::operator()(void *tcb, const char *name) {
+    if (strlen(name) > ROANIX_THREAD_NAME_MAX)
+        return ERANGE;
+    long result = roanix_syscall2(
+        ROANIX_SYS_THREAD_SET_NAME,
+        tcb_tid(tcb),
+        as_word(name)
+    );
+    return syscall_error(result);
+}
+
+int Sysdeps<ThreadGetname>::operator()(void *tcb, char *name, size_t size) {
+    long result = roanix_syscall3(
+        ROANIX_SYS_THREAD_GET_NAME,
+        tcb_tid(tcb),
+        as_word(name),
+        static_cast<long>(size)
+    );
+    return syscall_error(result);
+}
+
+} // namespace mlibc
