+int Sysdeps<Umask>::operator()(mode_t mode, mode_t *old) {
+    long result = roanix_syscall1(ROANIX_SYS_FILE_UMASK, mode);
+    int error = syscall_error(result);
+    if (!error)
+        *old = static_cast<mode_t>(result);
+    return error;
+}
