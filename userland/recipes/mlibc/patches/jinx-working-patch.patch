+constexpr bool syscall_failed(long result) {
+    return result < 0 && result >= -4095;
+}
+
+int syscall_error(long result) {
+    return syscall_failed(result) ? static_cast<int>(-result) : 0;
+}
+
+long as_word(const void *pointer) {
+    return static_cast<long>(reinterpret_cast<uintptr_t>(pointer));
+}
+
+constexpr unsigned long kTcgets = 0x5401;
+constexpr unsigned long kTcsets = 0x5402;
+constexpr unsigned long kTcsetsw = 0x5403;
+constexpr unsigned long kTcsetsf = 0x5404;
+constexpr unsigned long kTcsbrk = 0x5409;
+constexpr unsigned long kTcxonc = 0x540A;
+constexpr unsigned long kTiocgptn = 0x80045430;
+constexpr unsigned long kTiocsptlck = 0x40045431;
+constexpr unsigned long kTcflsh = 0x540B;
+constexpr unsigned long kTiocgwinsz = 0x5413;
+constexpr unsigned long kTiocswinsz = 0x5414;
