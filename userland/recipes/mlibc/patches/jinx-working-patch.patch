+int Sysdeps<Stat>::operator()(
+        mlibc::fsfd_target target,
+        int fd,
+        const char *path,
+        int flags,
+        struct stat *output) {
+    struct roanix_stat source;
+    long result;
+    if (target == mlibc::fsfd_target::fd) {
+        result = roanix_syscall2(
+            ROANIX_SYS_FILE_FSTAT, fd, as_word(&source));
+    } else if (target == mlibc::fsfd_target::path
+            || (target == mlibc::fsfd_target::fd_path && fd == AT_FDCWD)) {
+        result = roanix_syscall3(
+            ROANIX_SYS_FILE_STAT, as_word(path), flags, as_word(&source));
+    } else {
+        return ENOSYS;
+    }
+    int error = syscall_error(result);
+    if (!error)
+        fill_stat(source, output);
+    return error;
