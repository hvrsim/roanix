+int Sysdeps<Openpty>::operator()(
+        int *master_fd,
+        int *slave_fd,
+        char *name,
+        const struct termios *settings,
+        const struct winsize *window) {
+    int master;
+    int error = sysdep<Open>(
+        "/dev/ptmx", O_RDWR | O_NOCTTY, 0, &master);
+    if (error)
+        return error;
+
+    char path[32];
+    error = sysdep<Ptsname>(master, path, sizeof(path));
+    if (!error)
+        error = sysdep<Unlockpt>(master);
+
+    int slave = -1;
+    if (!error)
+        error = sysdep<Open>(path, O_RDWR | O_NOCTTY, 0, &slave);
+    if (!error && settings)
+        error = sysdep<Tcsetattr>(slave, TCSAFLUSH, settings);
+    if (!error && window)
+        error = sysdep<Tcsetwinsize>(slave, window);
+
+    if (error) {
+        if (slave >= 0)
+            sysdep<Close>(slave);
+        sysdep<Close>(master);
+        return error;
+    }
+
+    if (name) {
+        size_t length = strlen(path) + 1;
+        memcpy(name, path, length);
+    }
+    *master_fd = master;
+    *slave_fd = slave;
+    return 0;
+}
+
+int Sysdeps<Ptsname>::operator()(int fd, char *buffer, size_t length) {
+    unsigned int index;
+    int result;
+    int error = sysdep<Ioctl>(fd, kTiocgptn, &index, &result);
+    if (error)
+        return error;
+
+    char digits[10];
+    size_t count = 0;
+    do {
+        digits[count++] = static_cast<char>('0' + index % 10);
+        index /= 10;
+    } while (index);
+
+    constexpr char prefix[] = "/dev/pts/";
+    size_t required = sizeof(prefix) - 1 + count + 1;
+    if (length < required)
+        return ERANGE;
+    memcpy(buffer, prefix, sizeof(prefix) - 1);
+    for (size_t position = 0; position < count; ++position)
+        buffer[sizeof(prefix) - 1 + position] = digits[count - position - 1];
+    buffer[required - 1] = '\0';
+    return 0;
+}
