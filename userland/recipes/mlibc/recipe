#! /bin/sh

from_source=mlibc-source
revision=7
imagedeps="meson ninja-build"
hostdeps="bootstrap-gcc binutils"
deps="mlibc-headers"

configure() {
    meson setup build "${source_dir}" \
        --cross-file="${CROSS_FILE}" \
        --prefix="${prefix}" \
        --libdir=lib \
        -Dno_headers=true \
        -Ddefault_library=shared \
        -Dposix_option=enabled \
        -Dlinux_option=disabled \
        -Dglibc_option=enabled \
        -Dbsd_option=disabled
}

build() {
    ninja -C build
}

package() {
    DESTDIR="${dest_dir}" ninja -C build install
}
