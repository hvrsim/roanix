[Unit]
Description=Roanix Graphical Console
Requires=systemd-logind.service systemd-udev-trigger.service
After=systemd-logind.service systemd-udev-trigger.service
ConditionPathExists=/dev/dri/card0

[Service]
ExecStart=/usr/bin/kmscon --no-reset-env --session-control --login -- /usr/bin/bash
Environment=TERM=vt220
StandardInput=null
StandardOutput=kmsg
StandardError=inherit
SendSIGHUP=yes
KillMode=process
TimeoutStopSec=5s
Restart=always
RestartSec=1s
