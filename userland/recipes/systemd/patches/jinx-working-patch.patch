                 return -EADDRNOTAVAIL;
 
+#ifdef __roanix__
+        /* The native process registry exposes parent identity in status;
+         * it does not provide Linux's full scheduling/accounting stat record. */
+        p = procfs_file_alloca(pid, "status");
+        r = get_proc_field(p, "PPid", WHITESPACE, &line);
+#else
         p = procfs_file_alloca(pid, "stat");
         r = read_one_line_file(p, &line);
+#endif
         if (r == -ENOENT)
                 return -ESRCH;
         if (r < 0)
                 return r;
 
+#ifdef __roanix__
+        r = safe_atolu(line, &ppid);
+        if (r < 0)
+                return r;
+#else
