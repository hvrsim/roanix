JINX_MAJOR_VER=0.4

export common_arch="$COMMON_ARCH"
export common_target="$COMMON_TARGET"
export common_meson_buildtype="$COMMON_BUILDTYPE"

HOST_CFLAGS="-O2 -pipe -fstack-clash-protection"
HOST_CXXFLAGS="$${HOST_CFLAGS} -Wp,-D_GLIBCXX_ASSERTIONS"
HOST_LDFLAGS="$COMMON_LDFLAGS"

TARGET_CFLAGS="$COMMON_CFLAGS -pipe"
TARGET_CXXFLAGS="$${CFLAGS} -Wp,-D_GLIBCXX_ASSERTIONS"
TARGET_LDFLAGS="$COMMON_LDFLAGS"

post_package_strip() {
    if [ -z "$$strip_command" ]; then
        strip_command="$${common_target}-strip"
    fi

    # If we are doing a debug user build, don't strip binaries.
    if [ -z "$$host_build" ]; then
        case "$$common_meson_buildtype" in
            *debug* )
                return
                ;;
        esac 
    fi

    for f in $$(find "$${dest_dir}"); do
        if file "$$f" | grep 'not stripped' >/dev/null; then
            echo "* stripping '$$f'..."
            stripped_file="$$(mktemp)"
            $${strip_command} "$$f" -o "$$stripped_file"
            chmod --reference="$$f" "$$stripped_file"
            mv -f "$$stripped_file" "$$f"
        fi
    done
}

autotools_configure() {
        CFLAGS="$$TARGET_CFLAGS" \
        CXXFLAGS="$$TARGET_CXXFLAGS" \
        LDFLAGS="$$TARGET_LDFLAGS" \
    autotools_configure_noflags "$$@"
}

autotools_configure_noflags() {
    if [ -z "$${configure_script_path}" ]; then
        configure_script_path="$${source_dir}/configure"
    fi

        ac_cv_func_malloc_0_nonnull=yes \
        ac_cv_func_calloc_0_nonnull=yes \
        ac_cv_func_realloc_0_nonnull=yes \
    $${configure_script_path} \
        --host=$${common_target} \
        --with-sysroot=$${sysroot_dir} \
        --prefix=$${prefix} \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --bindir=$${prefix}/bin \
        --sbindir=$${prefix}/bin \
        --libdir=$${prefix}/lib \
        --disable-static \
        --enable-shared \
        --disable-malloc0returnsnull \
        "$$@"
}

autotools_recursive_regen() {
    ACLOCAL_INCLUDE=""
    if [ -d $${sysroot_dir}/usr/share/aclocal ]; then
        ACLOCAL_INCLUDE="-I$${sysroot_dir}/usr/share/aclocal"
    fi

    for f in $$(find . -name configure.ac -o -name configure.in -type f | sort); do
        echo "* autotools regen in '$$(dirname $$f)'..."
        ( cd "$$(dirname "$$f")" && autoreconf -fvi "$$@" $$ACLOCAL_INCLUDE )
    done
}

meson_configure() {
        CFLAGS="$$TARGET_CFLAGS" \
        CXXFLAGS="$$TARGET_CXXFLAGS" \
        LDFLAGS="$$TARGET_LDFLAGS" \
    meson_configure_noflags "$$@"
}

meson_configure_noflags() {
    if [ -z "$${meson_source_dir}" ]; then
        meson_source_dir="$${source_dir}"
    fi

    meson setup "$${meson_source_dir}" \
        --cross-file "$${base_dir}/scripts/cross-files/$${common_arch}-roanix.cross" \
        --prefix=$${prefix} \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --libdir=lib \
        --sbindir=bin \
        --buildtype=$$common_meson_buildtype \
        -Ddefault_library=shared \
        "$$@"
}

cmake_configure() {
        CFLAGS="$$TARGET_CFLAGS" \
        CXXFLAGS="$$TARGET_CXXFLAGS" \
        LDFLAGS="$$TARGET_LDFLAGS" \
    cmake_configure_noflags \
        "$$@"
}

cmake_configure_noflags() {
    if [ -z "$${cmake_source_dir}" ]; then
        cmake_source_dir="$${source_dir}"
    fi

    CB_TYPE="$${common_meson_buildtype}"
    if [ "$${common_meson_buildtype}" = "minsize" ]; then
    	CB_TYPE="MinSizeRel"
    fi

    cmake "$${cmake_source_dir}" \
        -DCMAKE_TOOLCHAIN_FILE="$${base_dir}/scripts/cross-files/CMakeToolchain-$${common_arch}.txt" \
        -DCMAKE_INSTALL_PREFIX=$${prefix} \
        -DCMAKE_INSTALL_SYSCONFDIR=/etc \
        -DCMAKE_INSTALL_LOCALSTATEDIR=/var \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_SBINDIR=bin \
        -DCMAKE_BUILD_TYPE=$$CB_TYPE \
        -DBUILD_SHARED_LIBS=True \
        -DENABLE_STATIC=False \
        -DPKG_CONFIG_EXECUTABLE="/usr/local/bin/$${common_target}-pkg-config" \
        -GNinja \
        "$$@"
}
